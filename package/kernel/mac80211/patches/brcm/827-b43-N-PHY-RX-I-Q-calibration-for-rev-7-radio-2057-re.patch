From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Druchenko <bananos@dev.co.ua>
Date: Fri, 27 Nov 2026 22:14:40 +0200
Subject: [PATCH] b43: N-PHY: RX I/Q calibration for rev 7+ (radio 2057 rev 13)

b43's RX I/Q calibration for rev 3+ PHYs was a stub. Port brcmsmac's
wlc_phy_cal_rxiq_nphy_rev3() for rev 7+ with radio 2057 at 2.4 GHz: the
rev 7 PHY setup and cleanup, the TX-RX coupler setup, the gain search
over the rev 7 gain table with the TX power index it uses, and the
compensation from the I/Q estimate. Run it, so far only on radio 2057
rev 13 where it was tested, at PHY init and after a channel change, and
keep wl's values on that board as a fallback if it fails.

On an ASUS RT-N12 D1 it finds wl's gain (table entry 3) and its I/Q
gain terms (0x76 / 0x3f7, wl 0x7c / 0x3f8); client->AP throughput rises
from 17.8 to 21.1 Mbit/s (channel 11, HT20, 8 x 4 MiB medians).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/phy_n.c | 336 +++++++++++++++++++++-
 1 file changed, 332 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/phy_n.c b/drivers/net/wireless/broadcom/b43/phy_n.c
index 1ad4dbe..e824089 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -6020,9 +6020,327 @@ static int b43_nphy_rev2_cal_rx_iq(struct b43_wldev *dev,
 	return ret;
 }
 
+
+/*
+ * RX I/Q calibration of rev 7+ N-PHYs with radio 2057, ported from brcmsmac
+ * (wlc_phy_cal_rxiq_nphy_rev3() and its PHY setup, radio setup and gain
+ * search, rev 7 paths; RC calibration is rev < 7 only).
+ */
+#define B43_NPHY_RXCAL_TONEAMP		181
+#define B43_NPHY_RXCAL_TONEFREQ_20MHZ	2000
+#define B43_NPHY_RXCAL_TONEFREQ_40MHZ	4000
+
+struct b43_nphy_rxcal_gain {
+	u16 lpf_biq1, lpf_biq0, lna2, lna1;
+	s8 txpwrindex;
+};
+
+/* brcmsmac's nphy_ipa_rxcal_gaintbl_2GHz_rev7 */
+static const struct b43_nphy_rxcal_gain b43_nphy_rxcal_gaintbl_2g_rev7[] = {
+	{ 0, 0, 0, 0, 10 }, { 0, 0, 1, 0, 10 }, { 0, 1, 2, 0, 10 },
+	{ 0, 1, 3, 0, 10 }, { 0, 4, 3, 0, 10 }, { 0, 6, 3, 0, 10 },
+};
+
+struct b43_nphy_rxcal_save {
+	u16 phy[16];
+	u16 radio[4];
+	bool txidx_set[2];
+	u16 afe_over[2], dacgain[2], radgain[2], m1m2;
+};
+
+/* TX gain of the power control table's entry @idx on @core (brcmsmac's
+ * wlc_phy_txpwr_index_nphy() without the calibration restore), saved first */
+static void b43_nphy_rxcal_txpwr_index(struct b43_wldev *dev, u8 core, u8 idx,
+				       struct b43_nphy_rxcal_save *sv)
+{
+	u32 txgain = b43_ntab_read(dev, B43_NTAB32(26 + core, 192 + idx));
+	u16 m1m2, reg_over = core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1;
+	u16 reg_dac = core ? B43_NPHY_AFECTL_DACGAIN2 : B43_NPHY_AFECTL_DACGAIN1;
+	u16 rad_gain = (txgain >> 16) & 0x1ffff;
+	u8 bbmult = txgain & 0xff;
+
+	if (!sv->txidx_set[core]) {
+		sv->afe_over[core] = b43_phy_read(dev, reg_over);
+		sv->dacgain[core] = b43_phy_read(dev, reg_dac);
+		sv->radgain[core] = b43_ntab_read(dev, B43_NTAB16(7, 0x110 + core));
+		if (!sv->txidx_set[!core])
+			sv->m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+		sv->txidx_set[core] = true;
+	}
+	b43_phy_set(dev, reg_over, 0x0100);
+	b43_phy_write(dev, reg_dac, (txgain >> 8) & 0x3f);
+	b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core), rad_gain);
+	m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+	m1m2 &= core ? 0xff00 : 0x00ff;
+	m1m2 |= core ? bbmult : bbmult << 8;
+	b43_ntab_write(dev, B43_NTAB16(15, 87), m1m2);
+}
+
+static void b43_nphy_rxcal_txpwr_restore(struct b43_wldev *dev,
+					 struct b43_nphy_rxcal_save *sv)
+{
+	int core;
+
+	for (core = 0; core < 2; core++) {
+		if (!sv->txidx_set[core])
+			continue;
+		b43_phy_write(dev, core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1,
+			      sv->afe_over[core]);
+		b43_phy_write(dev, core ? B43_NPHY_AFECTL_DACGAIN2 :
+			      B43_NPHY_AFECTL_DACGAIN1, sv->dacgain[core]);
+		b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core), sv->radgain[core]);
+	}
+	if (sv->txidx_set[0] || sv->txidx_set[1])
+		b43_ntab_write(dev, B43_NTAB16(15, 87), sv->m1m2);
+	sv->txidx_set[0] = sv->txidx_set[1] = false;
+}
+
+static const u16 b43_nphy_rxcal_phy_regs_rev7[] = {
+	0x0a2, 0x091, 0x092, 0x07a, 0x07d, 0x0e7, 0x0ec,
+	0x342, 0x343, 0x346, 0x347, 0x297, 0x29b,
+};
+
+static void b43_nphy_rxcal_phy_setup_rev7(struct b43_wldev *dev, u8 rx_core,
+					  struct b43_nphy_rxcal_save *sv)
+{
+	u16 afe_c = rx_core ? B43_NPHY_AFECTL_C2 : B43_NPHY_AFECTL_C1;
+	u16 afe_over = rx_core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1;
+	u8 tx_core = rx_core;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(b43_nphy_rxcal_phy_regs_rev7); i++)
+		sv->phy[i] = b43_phy_read(dev, b43_nphy_rxcal_phy_regs_rev7[i]);
+	sv->phy[13] = b43_phy_read(dev, afe_c);
+	sv->phy[14] = b43_phy_read(dev, afe_over);
+
+	b43_phy_mask(dev, 0x297, ~0x0001);
+	b43_phy_mask(dev, 0x29b, ~0x0001);
+
+	b43_phy_maskset(dev, B43_NPHY_RFSEQCA, 0xfff0, 1 << tx_core);
+	b43_phy_maskset(dev, B43_NPHY_RFSEQCA, 0x0fff, (1 << (1 - rx_core)) << 12);
+
+	b43_phy_mask(dev, afe_c, ~0x0004);
+	b43_phy_set(dev, afe_over, 0x0004);
+
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_PA, 0, 3);
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0, false, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x200, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x400, 1, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1, 1, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x2, 1, 0, false, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x800, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80, b43_is_40mhz(dev) ? 2 : 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x20, 0, 0, false, 1);
+
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RX2TX);
+
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_TRSW, 0x1, rx_core + 1);
+}
+
+static void b43_nphy_rxcal_phy_cleanup_rev7(struct b43_wldev *dev, u8 rx_core,
+					    struct b43_nphy_rxcal_save *sv)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(b43_nphy_rxcal_phy_regs_rev7); i++)
+		b43_phy_write(dev, b43_nphy_rxcal_phy_regs_rev7[i], sv->phy[i]);
+	b43_phy_write(dev, rx_core ? B43_NPHY_AFECTL_C2 : B43_NPHY_AFECTL_C1, sv->phy[13]);
+	b43_phy_write(dev, rx_core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1,
+		      sv->phy[14]);
+}
+
+/* the TX-RX coupler of radio 2057 at 2.4 GHz */
+static void b43_nphy_rxcal_radio_setup_rev7(struct b43_wldev *dev, u8 rx_core,
+					    struct b43_nphy_rxcal_save *sv)
+{
+
+	sv->radio[0] = b43_radio_read(dev, R2057_TX0_TXRXCOUPLE_2G_PWRUP);
+	sv->radio[1] = b43_radio_read(dev, R2057_TX0_TXRXCOUPLE_2G_ATTEN);
+	sv->radio[2] = b43_radio_read(dev, R2057_TX1_TXRXCOUPLE_2G_PWRUP);
+	sv->radio[3] = b43_radio_read(dev, R2057_TX1_TXRXCOUPLE_2G_ATTEN);
+
+	/* as brcmsmac, and as wl 5.110 on radio rev 13 */
+	b43_radio_write(dev, rx_core ? R2057_TX1_TXRXCOUPLE_2G_PWRUP :
+			R2057_TX0_TXRXCOUPLE_2G_PWRUP, 0x3);
+	b43_radio_write(dev, rx_core ? R2057_TX1_TXRXCOUPLE_2G_ATTEN :
+			R2057_TX0_TXRXCOUPLE_2G_ATTEN, 0x7f);
+}
+
+static void b43_nphy_rxcal_radio_cleanup_rev7(struct b43_wldev *dev,
+					      struct b43_nphy_rxcal_save *sv)
+{
+	b43_radio_write(dev, R2057_TX0_TXRXCOUPLE_2G_PWRUP, sv->radio[0]);
+	b43_radio_write(dev, R2057_TX0_TXRXCOUPLE_2G_ATTEN, sv->radio[1]);
+	b43_radio_write(dev, R2057_TX1_TXRXCOUPLE_2G_PWRUP, sv->radio[2]);
+	b43_radio_write(dev, R2057_TX1_TXRXCOUPLE_2G_ATTEN, sv->radio[3]);
+}
+
+static void b43_nphy_rxcal_set_rxgain(struct b43_wldev *dev,
+				      const struct b43_nphy_rxcal_gain *g,
+				      u16 lpf_biq1)
+{
+	const u16 mix_tia_gain = 3;
+
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_RX_GAIN,
+		(lpf_biq1 << 12) | (g->lpf_biq0 << 8) | (mix_tia_gain << 4) |
+		(g->lna2 << 2) | g->lna1, 0x3, false);
+}
+
+/* brcmsmac's wlc_phy_rxcal_gainctrl_nphy_rev5(), rev 7 at 2.4 GHz */
+static void b43_nphy_rxcal_gainctrl_rev7(struct b43_wldev *dev, u8 rx_core,
+					 struct b43_nphy_rxcal_save *sv)
+{
+	const struct b43_nphy_rxcal_gain *tbl = b43_nphy_rxcal_gaintbl_2g_rev7;
+	const int max_idx = ARRAY_SIZE(b43_nphy_rxcal_gaintbl_2g_rev7) - 1;
+	const u32 thresh_pwr = 10000;
+	const u16 num_samps = 1024;
+	struct b43_phy_n_iq_comp save_comp, zero_comp = { };
+	struct nphy_iq_est est;
+	u32 i_pwr, q_pwr, curr_pwr, optim_pwr = 0, prev_pwr = 0;
+	int curr = 3, prev = 0, optim = 0, dirn = 0;	/* 0 init, 1 up, 2 down */
+	bool done = false;
+	int fine, delta;
+	u16 lpf_biq1;
+	u8 tx_core = rx_core;
+
+	b43_nphy_rx_iq_coeffs(dev, false, &save_comp);
+	b43_nphy_rx_iq_coeffs(dev, true, &zero_comp);
+
+	do {
+		b43_nphy_rxcal_set_rxgain(dev, &tbl[curr], tbl[curr].lpf_biq1);
+		b43_nphy_rxcal_txpwr_index(dev, tx_core, tbl[curr].txpwrindex, sv);
+		b43_nphy_tx_tone(dev, b43_is_40mhz(dev) ?
+				 B43_NPHY_RXCAL_TONEFREQ_40MHZ :
+				 B43_NPHY_RXCAL_TONEFREQ_20MHZ,
+				 B43_NPHY_RXCAL_TONEAMP, false, false, false);
+		b43_nphy_rx_iq_est(dev, &est, num_samps, 32, false);
+		i_pwr = ((rx_core ? est.i1_pwr : est.i0_pwr) + num_samps / 2) / num_samps;
+		q_pwr = ((rx_core ? est.q1_pwr : est.q0_pwr) + num_samps / 2) / num_samps;
+		curr_pwr = i_pwr + q_pwr;
+
+		switch (dirn) {
+		case 0:
+			prev = curr;
+			if (curr_pwr > thresh_pwr) {
+				dirn = 2;
+				curr--;
+			} else {
+				dirn = 1;
+				curr++;
+			}
+			break;
+		case 1:
+			if (curr_pwr > thresh_pwr) {
+				done = true;
+				optim_pwr = prev_pwr;
+				optim = prev;
+			} else {
+				prev = curr;
+				curr++;
+			}
+			break;
+		case 2:
+			if (curr_pwr > thresh_pwr) {
+				prev = curr;
+				curr--;
+			} else {
+				done = true;
+				optim_pwr = curr_pwr;
+				optim = curr;
+			}
+			break;
+		}
+		if (!done && (curr < 0 || curr > max_idx)) {
+			done = true;
+			optim_pwr = curr_pwr;
+			optim = prev;
+		} else {
+			prev_pwr = curr_pwr;
+		}
+		b43_nphy_stop_playback(dev);
+	} while (!done);
+
+	/* fine gain: the LPF biquad 1 brings the tone to 2^13 */
+	delta = 13 - (optim_pwr ? fls(optim_pwr) : 0);
+	fine = (int)tbl[optim].lpf_biq1 + delta;
+	if (fine + (int)tbl[optim].lpf_biq0 > 10)
+		lpf_biq1 = 10 - tbl[optim].lpf_biq0;
+	else
+		lpf_biq1 = max(fine, 0);
+	b43_nphy_rxcal_set_rxgain(dev, &tbl[optim], lpf_biq1);
+	b43dbg(dev->wl, "RX cal core %u: gain index %d, power %u, LPF biq1 %u\n",
+	       rx_core, optim, optim_pwr, lpf_biq1);
+
+	b43_nphy_rx_iq_coeffs(dev, true, &save_comp);
+}
+
+static int b43_nphy_rev7_cal_rx_iq(struct b43_wldev *dev,
+				   struct nphy_txgains target)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	struct b43_nphy_rxcal_save sv = { };
+	struct nphy_iqcal_params params[2];
+	u16 bbcfg, gain_save[2], cal_gain[2];
+	u8 rxcore_state, core;
+	bool avoid = nphy->hang_avoid;
+
+	if (b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return -EOPNOTSUPP;
+
+	bbcfg = b43_phy_read(dev, B43_NPHY_BBCFG);
+	b43_phy_mask(dev, B43_NPHY_BBCFG, 0x7fff);
+	b43_nphy_stay_in_carrier_search(dev, true);
+	nphy->hang_avoid = false;
+
+	b43_ntab_read_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_save);
+	for (core = 0; core < 2; core++) {
+		b43_nphy_iq_cal_gain_params(dev, core, target, &params[core]);
+		cal_gain[core] = params[core].cal_gain;
+	}
+	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, cal_gain);
+
+	rxcore_state = b43_nphy_get_rx_core_state(dev);
+	for (core = 0; core < 2; core++) {
+		if (!(rxcore_state & (1 << core)))
+			continue;
+		b43_nphy_rxcal_phy_setup_rev7(dev, core, &sv);
+		b43_nphy_rxcal_radio_setup_rev7(dev, core, &sv);
+		b43_nphy_rxcal_gainctrl_rev7(dev, core, &sv);
+		b43_nphy_tx_tone(dev, b43_is_40mhz(dev) ?
+				 B43_NPHY_RXCAL_TONEFREQ_40MHZ :
+				 B43_NPHY_RXCAL_TONEFREQ_20MHZ,
+				 B43_NPHY_RXCAL_TONEAMP, false, false, false);
+		b43_nphy_calc_rx_iq_comp(dev, 1 << core);
+		b43_nphy_stop_playback(dev);
+		b43_nphy_rxcal_txpwr_restore(dev, &sv);
+		b43_nphy_rxcal_radio_cleanup_rev7(dev, &sv);
+		b43_nphy_rxcal_phy_cleanup_rev7(dev, core, &sv);
+		b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RESET2RX);
+	}
+
+	b43_phy_write(dev, B43_NPHY_BBCFG, bbcfg);
+	b43_nphy_reset_cca(dev);
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_RX_GAIN, 0,
+					     0x3, true);
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RESET2RX);
+	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_save);
+
+	nphy->hang_avoid = avoid;
+	b43_nphy_stay_in_carrier_search(dev, false);
+	return 0;
+}
+
 static int b43_nphy_rev3_cal_rx_iq(struct b43_wldev *dev,
 			struct nphy_txgains target, u8 type, bool debug)
 {
+	struct b43_phy *phy = &dev->phy;
+
+	/* so far only where it was tested: radio 2057 rev 13 */
+	if (phy->rev >= 7 && phy->rev < 19 && phy->radio_ver == 0x2057 &&
+	    phy->radio_rev == 13)
+		return b43_nphy_rev7_cal_rx_iq(dev, target);
 	return -1;
 }
 
@@ -6356,6 +6674,7 @@ static int b43_phy_initn(struct b43_wldev *dev)
 
 	u16 clip[2];
 	bool do_cal = false;
+	bool rxcal_ok = false;
 
 	if ((dev->phy.rev >= 3) &&
 	   (sprom->boardflags_lo & B43_BFL_EXTLNA) &&
@@ -6536,8 +6855,10 @@ static int b43_phy_initn(struct b43_wldev *dev)
 						target = b43_nphy_precal_txgain_2057_rev13(dev);
 				}
 				if (!b43_nphy_cal_tx_iq_lo(dev, target, true, false))
-					if (b43_nphy_cal_rx_iq(dev, target, 2, 0) == 0)
+					if (b43_nphy_cal_rx_iq(dev, target, 2, 0) == 0) {
+						rxcal_ok = true;
 						b43_nphy_save_cal(dev);
+					}
 			} else if (nphy->mphase_cal_phase_id == 0)
 				;/* N PHY Periodic Calibration with arg 3 */
 		} else {
@@ -6568,9 +6889,15 @@ static int b43_phy_initn(struct b43_wldev *dev)
 		for (k = 0; k < ARRAY_SIZE(rssi_regs); k++)
 			b43_phy_write(dev, rssi_regs[k][0], rssi_regs[k][1]);
 	}
-	if (phy->radio_ver == 0x2057 && phy->radio_rev == 13) {
-		/* the RX I/Q compensation wl 5.110 calibrates on the RT-N12 D1:
-		 * b43's RX I/Q calibration for rev 3+ PHYs is a stub */
+	if (phy->radio_ver == 0x2057 && phy->radio_rev == 13 && rxcal_ok) {
+		struct b43_phy_n_iq_comp c;
+
+		b43_nphy_rx_iq_coeffs(dev, false, &c);
+		b43dbg(dev->wl, "RX I/Q comp: %04x %04x %04x %04x\n",
+		       (u16)c.a0, (u16)c.b0, (u16)c.a1, (u16)c.b1);
+	} else if (phy->radio_ver == 0x2057 && phy->radio_rev == 13) {
+		/* the RX I/Q compensation wl 5.110 calibrates on the RT-N12 D1,
+		 * if the RX I/Q calibration did not run */
 		b43_phy_write(dev, B43_NPHY_C1_RXIQ_COMPA0, 0x007c);
 		b43_phy_write(dev, B43_NPHY_C1_RXIQ_COMPB0, 0x000d);
 		b43_phy_write(dev, B43_NPHY_C2_RXIQ_COMPA1, 0x03f8);
@@ -7045,6 +7372,7 @@ static void b43_nphy_rev13_recal(struct b43_wldev *dev)
 	b43_nphy_tx_power_ctrl(dev, false);
 	target = b43_nphy_precal_txgain_2057_rev13(dev);
 	b43_nphy_cal_tx_iq_lo(dev, target, true, false);
+	b43_nphy_cal_rx_iq(dev, target, 2, 0);
 	b43_nphy_tx_pwr_ctrl_coef_setup(dev);
 	b43_nphy_tx_power_ctrl(dev, pwrctl);
 	b43_ntab_read_bulk(dev, B43_NTAB16(15, 80), 4, c);
-- 
