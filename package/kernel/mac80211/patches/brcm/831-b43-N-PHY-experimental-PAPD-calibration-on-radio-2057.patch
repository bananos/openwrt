From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Druchenko <bananos@dev.co.ua>
Date: Sat, 28 Nov 2026 11:32:00 +0200
Subject: [PATCH] b43: N-PHY: experimental PAPD calibration on radio 2057 rev
 13

Port brcmsmac's IPA PA pre-distortion calibration (the rev 7+ 2 GHz path
of wlc_phy_a4() and its helpers) for radio 2057 rev 13, with the values
wl uses there: coupler attenuation 0xf2, a PAD gain search from code 14
down with a settle window of 55 and correlation shift 0x10, the full run
with 25 and 0x20, and the PAPD engine's core in 0x35a (0x358 cleared),
which brcmsmac does not write. It runs between the TX I/Q-LO and the RX
I/Q calibration, as in brcmsmac and wl.

The epsilon offset rev 13 needs comes from a PAD gain delta table
brcmsmac lacks; only the values wl writes for codes 7 and 8 are known,
so other codes leave the compensation off.

Off by default (papd=1 turns it on): on an ASUS RT-N12 D1 core 1's
search ends at code 6 or 8 where wl's ends at 8, and throughput did not
improve with the compensation on; an offset guessed for code 6 broke
uploads.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/phy_n.c | 351 +++++++++++++++++++++-
 1 file changed, 349 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/phy_n.c b/drivers/net/wireless/broadcom/b43/phy_n.c
index 66cacc1..39c82bd 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -5307,6 +5307,350 @@ static void b43_nphy_tx_cal_phy_cleanup(struct b43_wldev *dev)
 	}
 }
 
+/**************************************************
+ * PA pre-distortion (PAPD) calibration, radio 2057 rev 13
+ **************************************************/
+
+/*
+ * brcmsmac's IPA PAPD calibration (wlc_phy_a4() and its helpers) for the
+ * rev 7+ 2 GHz path, with the radio 2057 rev 13 values wl 5.110 uses on the
+ * ASUS RT-N12 D1: coupler attenuation 0xf2, a PAD gain search from code 14
+ * down, the search's settle window of 55 and correlation shift 0x10.
+ * The PAPD engine fills epsilon tables 31/33.
+ *
+ * Experimental (papd=1): the search does not always end where wl's does
+ * (core 1 found code 6 or 8 where wl finds 8) and throughput on the RT-N12 D1
+ * did not improve with the compensation on.
+ */
+static bool modparam_papd;
+module_param_named(papd, modparam_papd, bool, 0444);
+MODULE_PARM_DESC(papd, "PAPD calibration on radio 2057 rev 13 (experimental, 0 default)");
+
+static const u32 b43_nphy_papd_scaltbl[] = {
+	0x0ae2002f, 0x0a3b0032, 0x09a70035, 0x09220038,
+	0x0887003c, 0x081f003f, 0x07a20043, 0x07340047,
+	0x06d2004b, 0x067a004f, 0x06170054, 0x05bf0059,
+	0x0571005e, 0x051e0064, 0x04d3006a, 0x04910070,
+	0x044c0077, 0x040f007e, 0x03d90085, 0x03a1008d,
+	0x036f0095, 0x033d009e, 0x030b00a8, 0x02e000b2,
+	0x02b900bc, 0x029200c7, 0x026d00d3, 0x024900e0,
+	0x022900ed, 0x020a00fb, 0x01ec010a, 0x01d0011a,
+	0x01b7012a, 0x019e013c, 0x0187014f, 0x01720162,
+	0x015d0177, 0x0149018e, 0x013701a5, 0x012601be,
+	0x011501d9, 0x010501f5, 0x00f70212, 0x00e90232,
+	0x00dc0253, 0x00d00276, 0x00c4029c, 0x00b902c3,
+	0x00af02ed, 0x00a5031a, 0x009c0349, 0x0093037a,
+	0x008b03af, 0x008303e7, 0x007c0422, 0x00750461,
+	0x006e04a3, 0x006804ea, 0x00620534, 0x005d0583,
+	0x005805d7, 0x0053062f, 0x004e068d, 0x004a06f1
+};
+
+#define B43_NPHY_PAPD_EPS_TBL(core)	((core) ? 33 : 31)
+#define B43_NPHY_PAPD_SCAL_TBL(core)	((core) ? 34 : 32)
+#define B43_NPHY_PAPD_EN(core)		((core) ? B43_NPHY_PAPD_EN1 : \
+						  B43_NPHY_PAPD_EN0)
+#define B43_NPHY_PAPD_SHIFTS(core)	((core) ? B43_NPHY_PAPD_CAL_SHIFTS1 : \
+						  B43_NPHY_PAPD_CAL_SHIFTS0)
+#define B43_NPHY_PAPD_EPS_ADJ(core)	((core) ? B43_NPHY_EPS_TABLE_ADJ1 : \
+						  B43_NPHY_EPS_TABLE_ADJ0)
+#define B43_NPHY_PAPD_CAL_YREF		B43_NPHY_PAPD_CAL_YREFEPSILON
+#define B43_NPHY_PAPD_CAL_CORR_SHIFT	B43_PHY_N(0x2E5)
+#define B43_NPHY_PAPD_CAL_START		B43_PHY_N(0x2BE)
+
+struct b43_nphy_papd_state {
+	u16 afectl[2];
+	u16 afeover[2];
+	u16 atten[2];
+	u16 bbmult;
+};
+
+static void b43_nphy_papd_decode_eps(u32 eps, s32 *re, s32 *im)
+{
+	*im = sign_extend32(eps >> 13, 12);
+	*re = sign_extend32(eps & 0x1fff, 12);
+}
+
+static void b43_nphy_papd_set_bbmult(struct b43_wldev *dev, u8 m0, u8 m1)
+{
+	b43_ntab_write(dev, B43_NTAB16(15, 87), (m0 << 8) | m1);
+	b43_ntab_write(dev, B43_NTAB16(15, 95), (m0 << 8) | m1);
+}
+
+/* brcmsmac wlc_phy_papd_cal_setup_nphy(), rev 7+, 2 GHz */
+static void b43_nphy_papd_cal_setup(struct b43_wldev *dev,
+				    struct b43_nphy_papd_state *st, u8 core)
+{
+	u8 off = core ^ 1;
+	u16 atten0 = core ? R2057_TX1_TXRXCOUPLE_2G_ATTEN :
+			    R2057_TX0_TXRXCOUPLE_2G_ATTEN;
+	u16 atten1 = off ? R2057_TX1_TXRXCOUPLE_2G_ATTEN :
+			   R2057_TX0_TXRXCOUPLE_2G_ATTEN;
+	u16 afectl0 = core ? B43_NPHY_AFECTL_C2 : B43_NPHY_AFECTL_C1;
+	u16 afectl1 = core ? B43_NPHY_AFECTL_C1 : B43_NPHY_AFECTL_C2;
+	u16 afeover0 = core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1;
+	u16 afeover1 = core ? B43_NPHY_AFECTL_OVER1 : B43_NPHY_AFECTL_OVER;
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80, b43_nphy_read_lpf_ctl(dev, 0),
+				      0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x800, 0, 1 << core, false, 0);
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_TX_PU, 1,
+					     1 << core, false);
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_TX_PU, 0,
+					     1 << off, false);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0x3, false, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x4, 1, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1, 0, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x2, 1, 1 << core, false, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x100, 0, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x200, 1, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x400, 0, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 1, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x20, 0, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x10, 0, 1 << core, false, 1);
+
+	st->afectl[core] = b43_phy_read(dev, afectl0);
+	st->afeover[core] = b43_phy_read(dev, afeover0);
+	st->afectl[off] = b43_phy_read(dev, afectl1);
+	st->afeover[off] = b43_phy_read(dev, afeover1);
+	b43_phy_mask(dev, afectl0, ~0x4);
+	b43_phy_set(dev, afeover0, 0x4);
+	b43_phy_set(dev, afectl1, 0x4);
+	b43_phy_set(dev, afeover1, 0x4);
+
+	st->atten[core] = b43_radio_read(dev, atten0);
+	st->atten[off] = b43_radio_read(dev, atten1);
+	b43_radio_write(dev, atten0 + 1, 0xc);	/* PWRUP */
+	b43_radio_write(dev, atten0, 0xf2);
+	b43_radio_write(dev, atten1 + 1, 0);
+	b43_radio_write(dev, atten1, 0xff);
+
+	b43_nphy_tx_tone(dev, 4000, 181, false, false, false);
+	b43_phy_set(dev, B43_NPHY_PAPD_EN(core), 0x1);
+	b43_phy_set(dev, B43_NPHY_PAPD_SHIFTS(core), 0x2000);
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN(off), ~0x1);
+	b43_phy_mask(dev, B43_NPHY_PAPD_SHIFTS(off), ~0x2000);
+}
+
+/* brcmsmac wlc_phy_papd_cal_cleanup_nphy(), rev 7+, 2 GHz */
+static void b43_nphy_papd_cal_cleanup(struct b43_wldev *dev,
+				      struct b43_nphy_papd_state *st)
+{
+	u8 core;
+
+	b43_nphy_stop_playback(dev);
+	for (core = 0; core < 2; core++) {
+		u16 atten = core ? R2057_TX1_TXRXCOUPLE_2G_ATTEN :
+				   R2057_TX0_TXRXCOUPLE_2G_ATTEN;
+
+		b43_radio_write(dev, atten + 1, 0);
+		b43_radio_write(dev, atten, st->atten[core]);
+	}
+	b43_nphy_rf_ctl_override_rev7(dev, 0x4, 0, 0x3, true, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x2, 0, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1, 0, 0x3, true, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x4, 0, 0x3, true, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x800, 1, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0x3, true, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x800, 0, 0x3, true, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1000, 0, 0x3, true, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x4, 1, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1, 0, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x2, 1, 0x3, true, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x100, 0, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x200, 1, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x400, 0, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 1, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x20, 0, 0x3, true, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x10, 0, 0x3, true, 1);
+	for (core = 0; core < 2; core++) {
+		b43_phy_write(dev, core ? B43_NPHY_AFECTL_C2 :
+			      B43_NPHY_AFECTL_C1, st->afectl[core]);
+		b43_phy_write(dev, core ? B43_NPHY_AFECTL_OVER :
+			      B43_NPHY_AFECTL_OVER1, st->afeover[core]);
+	}
+	b43_nphy_papd_set_bbmult(dev, st->bbmult >> 8, st->bbmult & 0xff);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80, 0, 0, true, 1);
+}
+
+/*
+ * brcmsmac wlc_phy_a2_nphy(), rev 7+, 2 GHz: one PAPD engine run on @core
+ * at PAD gain @pad; @search is the gain search's short run.
+ */
+static void b43_nphy_papd_cal_run(struct b43_wldev *dev, u8 core, u16 pad,
+				  bool search)
+{
+	struct nphy_txgains g = b43_nphy_get_tx_gains(dev);
+	u8 off = core ^ 1;
+	u8 m[2];
+	u16 gain;
+	u32 zero = 0;
+	int i;
+
+	gain = (g.tx_lpf[core] << 15) | (g.txgm[core] << 12) |
+	       (g.pga[core] << 8) | (pad << 3) | g.ipa[core];
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_TX_GAIN,
+					     gain, 1 << core, false);
+	m[core] = b43_is_40mhz(dev) ? 45 : 64;
+	m[off] = 0;
+	b43_nphy_papd_set_bbmult(dev, m[0], m[1]);
+	/* wl on rev 17: the core the PAPD engine works on */
+	b43_phy_write(dev, B43_PHY_N(0x35A), core);
+
+	b43_phy_set(dev, B43_NPHY_PAPD_EN(core), 0x1);
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN(off), ~0x1);
+	b43_phy_set(dev, B43_NPHY_PAPD_SHIFTS(core), 0x2000);
+	b43_phy_mask(dev, B43_NPHY_PAPD_SHIFTS(off), ~0x2000);
+	b43_phy_write(dev, B43_NPHY_PAPD_CAL_SETTLE, 0x80);
+	b43_phy_write(dev, B43_NPHY_PAPD_CAL_CORRELATE, 0x100);
+	b43_phy_maskset(dev, B43_NPHY_PAPD_SHIFTS(core), ~0x0007, 0x3);
+	b43_phy_write(dev, B43_PHY_N(0x358), 0);	/* wl on rev 17 */
+	b43_phy_maskset(dev, B43_NPHY_PAPD_SHIFTS(core), ~0x0070, 11 << 4);
+	b43_phy_maskset(dev, B43_NPHY_PAPD_SHIFTS(core), ~0x0700, 11 << 8);
+	/* wl on rev 13: 0x10 in the gain search, 0x20 in the full run */
+	b43_phy_write(dev, B43_NPHY_PAPD_CAL_CORR_SHIFT, search ? 0x10 : 0x20);
+	b43_phy_maskset(dev, B43_NPHY_PAPD_CAL_YREF, ~0x003f, 25);
+	b43_phy_maskset(dev, B43_NPHY_PAPD_CAL_ADDRESS, ~0x003f,
+			search ? 55 : 25);
+	b43_phy_maskset(dev, B43_NPHY_PAPD_CAL_ADDRESS, ~0x3f00, 63 << 8);
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 1, core ? 2 : 1, false, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, core ? 1 : 2, false, 0);
+	b43_phy_write(dev, B43_NPHY_PAPD_CAL_START, 1);
+	for (i = 0; i < 10000 && b43_phy_read(dev, B43_NPHY_PAPD_CAL_START);
+	     i++)
+		udelay(10);
+	if (i == 10000)
+		b43dbg(dev->wl, "PAPD calibration of core %u timed out\n",
+		       core);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0x3, false, 0);
+	b43_ntab_write(dev, B43_NTAB32(B43_NPHY_PAPD_EPS_TBL(core), 25), zero);
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_TX_GAIN,
+					     gain, 1 << core, true);
+}
+
+/*
+ * brcmsmac wlc_phy_a3_nphy(): lower the PAD gain until the last epsilon
+ * stops clipping. wl on rev 13 starts at code 14 and steps by one.
+ */
+static u16 b43_nphy_papd_gain_search(struct b43_wldev *dev, u8 core)
+{
+	int pad = 14, i;
+	bool clip, prev = false;
+
+	for (i = 0; i < 20; i++) {
+		s32 re, im;
+		u32 eps;
+
+		b43_nphy_papd_cal_run(dev, core, pad, true);
+		eps = b43_ntab_read(dev,
+				    B43_NTAB32(B43_NPHY_PAPD_EPS_TBL(core), 63));
+		b43_nphy_papd_decode_eps(eps, &re, &im);
+		clip = re == 4095 || re == -4096 || im == 4095 || im == -4096;
+		if (i && clip != prev) {
+			if (!clip)
+				pad++;
+			break;
+		}
+		pad += clip ? -1 : 1;
+		if (pad < 1 || pad > 14) {
+			pad = clamp(pad, 1, 14);
+			break;
+		}
+		prev = clip;
+	}
+	return pad;
+}
+
+/*
+ * The epsilon table offset wl writes after the calibration, by the PAD gain
+ * found: scaffolding transcribed from wl 5.110 on the RT-N12 D1 (codes 7 and
+ * 8); brcmsmac derives it from a PAD gain delta table rev 13 lacks. Following
+ * the step between them to code 6 broke uploads, so other codes leave the
+ * compensation off. Returns false for them.
+ */
+static bool b43_nphy_papd_eps_offset(u16 pad, s16 *offset)
+{
+	switch (pad) {
+	case 7:
+		*offset = -1;
+		return true;
+	case 8:
+		*offset = -4;
+		return true;
+	}
+	return false;
+}
+
+/* brcmsmac wlc_phy_a4() for radio 2057 rev 13. MAC suspended by the caller. */
+static void b43_nphy_papd_cal_rev13(struct b43_wldev *dev)
+{
+	struct b43_phy *phy = &dev->phy;
+	struct b43_phy_n *nphy = phy->n;
+	struct b43_nphy_papd_state st;
+	bool pwrctl = nphy->txpwrctrl;
+	u16 pad[2], r1;
+	s16 offset[2];
+	bool ok = true;
+	u8 core;
+	int i;
+
+	if (!modparam_papd || phy->radio_ver != 0x2057 ||
+	    phy->radio_rev != 13 ||
+	    b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return;
+
+	b43_nphy_stay_in_carrier_search(dev, true);
+	b43_nphy_tx_power_ctrl(dev, false);
+
+	for (core = 0; core < 2; core++)
+		b43_ntab_write_bulk(dev, B43_NTAB32(B43_NPHY_PAPD_SCAL_TBL(core), 0),
+				    ARRAY_SIZE(b43_nphy_papd_scaltbl),
+				    b43_nphy_papd_scaltbl);
+	r1 = b43_phy_read(dev, B43_PHY_N(0x001));
+	b43_phy_mask(dev, B43_PHY_N(0x001), ~0x8000);
+	for (core = 0; core < 2; core++)
+		for (i = 0; i < 64; i++)
+			b43_ntab_write(dev,
+				B43_NTAB32(B43_NPHY_PAPD_EPS_TBL(core), i), 0);
+
+	/* brcmsmac wlc_phy_ipa_restore_tx_digi_filts_nphy(), 20 MHz */
+	b43_nphy_pa_set_tx_dig_filter(dev, b43_is_40mhz(dev) ? 0x195 : 0x186,
+				      tbl_tx_filter_coef_rev4[b43_is_40mhz(dev) ? 4 : 3]);
+
+	st.bbmult = b43_ntab_read(dev, B43_NTAB16(15, 87));
+	for (core = 0; core < 2; core++) {
+		b43_nphy_papd_cal_setup(dev, &st, core);
+		pad[core] = b43_nphy_papd_gain_search(dev, core);
+		b43_nphy_papd_cal_run(dev, core, pad[core], false);
+		b43_nphy_papd_cal_cleanup(dev, &st);
+	}
+
+	for (core = 0; core < 2; core++)
+		ok &= b43_nphy_papd_eps_offset(pad[core], &offset[core]);
+	if (ok) {
+		for (core = 0; core < 2; core++) {
+			b43_phy_maskset(dev, B43_NPHY_PAPD_EPS_ADJ(core), 0x007f,
+					(offset[core] & 0x1ff) << 7);
+			nphy->papd_epsilon_offset[core] = offset[core];
+			b43_phy_set(dev, B43_NPHY_PAPD_EN(core), 0x1);
+			b43_phy_mask(dev, B43_NPHY_PAPD_SHIFTS(core), ~0x2000);
+		}
+	} else {
+		/* PAD gains wl was not seen with: compensation off */
+		for (core = 0; core < 2; core++) {
+			b43_phy_mask(dev, B43_NPHY_PAPD_EN(core), ~0x1);
+			b43_phy_mask(dev, B43_NPHY_PAPD_SHIFTS(core), ~0x2000);
+		}
+	}
+	b43dbg(dev->wl, "PAPD: PAD gains %u/%u, %s\n", pad[0], pad[1],
+	       ok ? "on" : "off (offsets unknown)");
+
+	b43_phy_write(dev, B43_PHY_N(0x001), r1);
+	b43_nphy_int_pa_set_tx_dig_filters(dev);
+	b43_nphy_tx_power_ctrl(dev, pwrctl);
+	b43_nphy_stay_in_carrier_search(dev, false);
+}
+
 /* http://bcm-v4.sipsolutions.net/802.11/PHY/N/TxCalPhySetup */
 static void b43_nphy_tx_cal_phy_setup(struct b43_wldev *dev)
 {
@@ -6862,11 +7206,13 @@ static int b43_phy_initn(struct b43_wldev *dev)
 					if (phy->radio_ver == 0x2057 && phy->radio_rev == 13)
 						target = b43_nphy_precal_txgain_2057_rev13(dev);
 				}
-				if (!b43_nphy_cal_tx_iq_lo(dev, target, true, false))
+				if (!b43_nphy_cal_tx_iq_lo(dev, target, true, false)) {
+					b43_nphy_papd_cal_rev13(dev);
 					if (b43_nphy_cal_rx_iq(dev, target, 2, 0) == 0) {
 						rxcal_ok = true;
 						b43_nphy_save_cal(dev);
 					}
+				}
 			} else if (nphy->mphase_cal_phase_id == 0)
 				;/* N PHY Periodic Calibration with arg 3 */
 		} else {
