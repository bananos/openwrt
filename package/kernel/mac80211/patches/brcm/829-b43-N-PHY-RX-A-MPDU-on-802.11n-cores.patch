From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Druchenko <bananos@dev.co.ua>
Date: Sat, 28 Nov 2026 00:11:01 +0200
Subject: [PATCH] b43: N-PHY: RX A-MPDU on 802.11n cores

Take RX block ack sessions (AMPDU_AGGREGATION, a 64-frame reorder
window, a 64 KiB A-MPDU limit): the microcode answers an A-MPDU with a
block ack and mac80211 reorders. TX A-MPDU is not done.

The microcode takes the block ack's TA from template RAM 0x48; write
the station address there, as b43-next does. Without it the peer drops
our block acks and retries every MPDU. Set the MIMO receive limit and
watchdog in shared memory as b43-next does too.

The MPDUs after the first of an A-MPDU come with an all-zero HT-SIG;
give them the last one received.

On an ASUS RT-N12 D1 (channel 11, HT20, ht=1): client->AP 24.3 Mbit/s
(was 22.7), AP->client 11.6.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/b43.h  |  5 +++
 drivers/net/wireless/broadcom/b43/main.c | 41 +++++++++++++++++++++++-
 drivers/net/wireless/broadcom/b43/xmit.c |  8 ++++-
 3 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 5691305..485a1d2 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -309,6 +309,9 @@ enum {
 #define B43_SHM_SH_PRSSIDLEN		0x0048	/* Probe Response SSID length */
 #define B43_SHM_SH_PRTLEN		0x004A	/* Probe Response template length */
 #define B43_SHM_SH_PRMAXTIME		0x0074	/* Probe Response max time */
+#define B43_SHM_SH_WATCHDOG_8TU	0x003C	/* MIMO receive watchdog */
+#define B43_SHM_SH_MIMO_MAXSYM	0x00BA	/* MIMO receive limit */
+#define B43_RAM_BA_TA		0x0048	/* Block ack TX address (template RAM) */
 #define B43_SHM_SH_PRPHYCTL		0x0188	/* Probe Response PHY TX control word */
 /* SHM_SHARED rate tables */
 #define B43_SHM_SH_OFDMDIRECT		0x01C0	/* Pointer to OFDM direct map */
@@ -827,6 +830,8 @@ enum {
 struct b43_wldev {
 	struct b43_bus_dev *dev;
 	struct b43_wl *wl;
+	/* The last HT-SIG received, for the later MPDUs of an A-MPDU */
+	u8 rx_ht_sig[6];
 	/* a completion event structure needed if this call is asynchronous */
 	struct completion fw_load_complete;
 
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 8d0a669..8a3430b 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -724,6 +724,11 @@ static void b43_write_mac_bssid_templates(struct b43_wldev *dev)
 		tmp |= (u32) (mac_bssid[i + 3]) << 24;
 		b43_ram_write(dev, 0x20 + i, tmp);
 	}
+	/* The microcode sends block acks with the TA from template RAM 0x48 */
+	if (dev->phy.nphy_ht) {
+		b43_ram_write(dev, B43_RAM_BA_TA, get_unaligned_le32(mac));
+		b43_ram_write(dev, B43_RAM_BA_TA + 4, get_unaligned_le16(mac + 4));
+	}
 }
 
 static void b43_upload_card_macaddress(struct b43_wldev *dev)
@@ -3337,6 +3342,10 @@ static int b43_chip_init(struct b43_wldev *dev)
 	/* Probe Response Timeout value */
 	/* FIXME: Default to 0, has to be set by ioctl probably... :-/ */
 	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_PRMAXTIME, 0);
+	if (dev->phy.nphy_ht) {
+		b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_MIMO_MAXSYM, 0xFFFF);
+		b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_WATCHDOG_8TU, 10);
+	}
 
 	/* Initially set the wireless operation mode. */
 	b43_adjust_opmode(dev);
@@ -5252,6 +5261,32 @@ static int b43_op_get_antenna(struct ieee80211_hw *hw, u32 *tx_ant, u32 *rx_ant)
 	return 0;
 }
 
+/* Block ack sessions: RX only so far (the microcode answers A-MPDUs with
+ * block acks, mac80211 reorders); b43 does not build TX A-MPDUs. */
+static int b43_op_ampdu_action(struct ieee80211_hw *hw,
+			       struct ieee80211_vif *vif,
+			       struct ieee80211_ampdu_params *params)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_wldev *dev;
+	int err = -EOPNOTSUPP;
+
+	switch (params->action) {
+	case IEEE80211_AMPDU_RX_START:
+		mutex_lock(&wl->mutex);
+		dev = wl->current_dev;
+		if (dev && b43_status(dev) >= B43_STAT_STARTED &&
+		    dev->phy.nphy_ht)
+			err = 0;
+		mutex_unlock(&wl->mutex);
+		return err;
+	case IEEE80211_AMPDU_RX_STOP:
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
 static const struct ieee80211_ops b43_hw_ops = {
 	.tx			= b43_op_tx,
 	.conf_tx		= b43_op_conf_tx,
@@ -5274,6 +5309,7 @@ static const struct ieee80211_ops b43_hw_ops = {
 	.get_survey		= b43_op_get_survey,
 	.rfkill_poll		= b43_rfkill_poll,
 	.set_antenna		= b43_op_set_antenna,
+	.ampdu_action		= b43_op_ampdu_action,
 	.get_antenna		= b43_op_get_antenna,
 };
 
@@ -5378,7 +5414,7 @@ static int b43_setup_bands(struct b43_wldev *dev,
 		memset(ht, 0, sizeof(*ht));
 		ht->ht_supported = true;
 		ht->cap = WLAN_HT_CAP_SM_PS_DISABLED << IEEE80211_HT_CAP_SM_PS_SHIFT;
-		ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_8K;
+		ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_64K;
 		ht->ampdu_density = IEEE80211_HT_MPDU_DENSITY_8;
 		ht->mcs.rx_mask[0] = 0xff;
 		ht->mcs.rx_mask[1] = 0xff;
@@ -5388,6 +5424,9 @@ static int b43_setup_bands(struct b43_wldev *dev,
 			ht->mcs.tx_params |= IEEE80211_HT_MCS_TX_RX_DIFF;
 		hw->wiphy->bands[NL80211_BAND_2GHZ] = band;
 		dev->phy.nphy_ht = true;
+		/* RX A-MPDU: the microcode sends the block acks */
+		ieee80211_hw_set(hw, AMPDU_AGGREGATION);
+		hw->max_rx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HT;
 	}
 
 	dev->phy.supports_2ghz = have_2ghz_phy;
diff --git a/drivers/net/wireless/broadcom/b43/xmit.c b/drivers/net/wireless/broadcom/b43/xmit.c
index fb97a19..2ec1ae7 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
@@ -923,7 +923,13 @@ void b43_rx(struct b43_wldev *dev, struct sk_buff *skb, const void *_rxhdr)
 	if (dev->phy.nphy_ht &&
 	    (phystat0 & B43_RX_PHYST0_FTYPE) >= B43_RX_PHYST0_PRE_N) {
 		/* 802.11n: the PLCP is the HT-SIG. N-PHY rev 17 reports
-		 * standard HT frames as type 2 (PRE_N). */
+		 * standard HT frames as type 2 (PRE_N). The MPDUs after the
+		 * first of an A-MPDU come without one (all zero): they get
+		 * the last HT-SIG seen. */
+		if (plcp->data || plcp->raw[4] || plcp->raw[5])
+			memcpy(dev->rx_ht_sig, plcp->raw, sizeof(dev->rx_ht_sig));
+		else
+			memcpy(plcp->raw, dev->rx_ht_sig, sizeof(dev->rx_ht_sig));
 		rate_idx = plcp->raw[0] & 0x7f;
 		status.encoding = RX_ENC_HT;
 		if (plcp->raw[0] & 0x80)
-- 
2.53.0

