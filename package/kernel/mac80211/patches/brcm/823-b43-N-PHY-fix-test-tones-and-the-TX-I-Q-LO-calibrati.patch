From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Druchenko <bananos@dev.co.ua>
Date: Fri, 27 Nov 2026 20:54:02 +0200
Subject: [PATCH] b43: N-PHY: fix test tones and the TX I/Q-LO calibration

Several bugs kept the N-PHY TX I/Q-LO calibration from ever producing
coefficients:

- b43_nphy_load_samples(): "samples[i].i & 0x3FF << 10" masked with
  0xFFC00 instead of shifting, dropping the I part of every tone.
- b43_nphy_gen_load_samples(): the phase step and phase are 16.16
  degrees but were u16, which kept only the fraction: at 2.5 and 4 MHz
  the step wrapped to exactly 0 and every tone was DC.
- b43_nphy_cal_tx_iq_lo() broke out of the wait for each I/Q-LO command
  as soon as the busy bits were set, reading the results before the
  command ran; it now waits while they are set, as brcmsmac does.
- The same function copied the best coefficients the wrong way (wrote
  96, read 80); it now reads 96 and writes 80, as brcmsmac.
- On rev 7+ the calibration left the TX radio registers and the RF
  overrides (LPF bandwidth, PA, the T/R switch bits in 0x2ff) as it set
  them, which leaves TX dead afterwards. Restore them, with the radio
  cleanup from b43-next and the PHY cleanup of brcmsmac.

The calibration only runs where the next patch enables it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/phy_n.c | 68 +++++++++++++++++++++--
 drivers/net/wireless/broadcom/b43/phy_n.h |  2 +-
 2 files changed, 64 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/phy_n.c b/drivers/net/wireless/broadcom/b43/phy_n.c
index d6323e1..154cab8 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -1542,7 +1542,7 @@ static int b43_nphy_load_samples(struct b43_wldev *dev,
 		b43_nphy_stay_in_carrier_search(dev, 1);
 
 	for (i = 0; i < len; i++) {
-		data[i] = (samples[i].i & 0x3FF << 10);
+		data[i] = (samples[i].i & 0x3FF) << 10;
 		data[i] |= samples[i].q & 0x3FF;
 	}
 	b43_ntab_write_bulk(dev, B43_NTAB32(17, 0), len, data);
@@ -1558,7 +1558,10 @@ static u16 b43_nphy_gen_load_samples(struct b43_wldev *dev, u32 freq, u16 max,
 					bool test)
 {
 	int i;
-	u16 bw, len, rot, angle;
+	u16 bw, len;
+	/* the phase step and phase in degrees, 16.16 fixed point: a u16 kept
+	 * only the fraction, 0 for 2.5 and 4 MHz at 20 MHz (a DC "tone") */
+	int rot, angle;
 	struct b43_c32 *samples;
 
 	bw = b43_is_40mhz(dev) ? 40 : 20;
@@ -4867,6 +4870,34 @@ static void b43_nphy_tx_cal_radio_setup_rev7(struct b43_wldev *dev)
 	}
 }
 
+/*
+ * Put back the radio registers b43_nphy_tx_cal_radio_setup_rev7() saved, as
+ * brcmsmac's wlc_phy_txcal_radio_cleanup_nphy() does (from b43-next). Left
+ * as the calibration set them, the TX path stays in I/Q calibration mode.
+ */
+static void b43_nphy_tx_cal_radio_cleanup_rev7(struct b43_wldev *dev)
+{
+	struct b43_phy *phy = &dev->phy;
+	u16 *save = dev->phy.n->tx_rx_cal_radio_saveregs;
+	int core, off;
+	u16 r;
+
+	for (core = 0; core < 2; core++) {
+		r = core ? 0x20 : 0;
+		off = core * 11;
+
+		b43_radio_write(dev, r + R2057_TX0_TX_SSI_MASTER, save[off + 0]);
+		b43_radio_write(dev, r + R2057_TX0_IQCAL_VCM_HG, save[off + 1]);
+		b43_radio_write(dev, r + R2057_TX0_IQCAL_IDAC, save[off + 2]);
+		b43_radio_write(dev, r + R2057_TX0_TSSI_VCM, save[off + 3]);
+		b43_radio_write(dev, r + R2057_TX0_TX_SSI_MUX, save[off + 5]);
+		if (phy->radio_rev != 5)
+			b43_radio_write(dev, r + R2057_TX0_TSSIA, save[off + 6]);
+		b43_radio_write(dev, r + R2057_TX0_TSSIG, save[off + 7]);
+		b43_radio_write(dev, r + R2057_TX0_TSSI_MISC1, save[off + 8]);
+	}
+}
+
 /* http://bcm-v4.sipsolutions.net/802.11/PHY/N/TxCalRadioSetup */
 static void b43_nphy_tx_cal_radio_setup(struct b43_wldev *dev)
 {
@@ -5139,7 +5170,24 @@ static void b43_nphy_tx_cal_phy_cleanup(struct b43_wldev *dev)
 		b43_phy_write(dev, B43_NPHY_RFCTL_INTC2, regs[8]);
 		b43_phy_write(dev, B43_NPHY_PAPD_EN0, regs[9]);
 		b43_phy_write(dev, B43_NPHY_PAPD_EN1, regs[10]);
+
+		/*
+		 * Release the RF control overrides b43_nphy_tx_cal_phy_setup()
+		 * set, as brcmsmac's wlc_phy_txcal_phycleanup_nphy() does (from
+		 * b43-next): the RX LPF bandwidth, and for the internal
+		 * calibration the PA (rev 8+). And the T/R switch override
+		 * bits the intc override left in 0x2ff.
+		 */
+		if (dev->phy.rev >= 7 && dev->phy.rev < 19) {
+			b43_nphy_rf_ctl_override_rev7(dev, 0x80, 0, 0, true, 1);
+			b43_phy_write(dev, 0x2ff, regs[13]);
+		}
+
 		b43_nphy_reset_cca(dev);
+
+		if (dev->phy.n->use_int_tx_iq_lo_cal && dev->phy.rev >= 8 &&
+		    dev->phy.rev < 19)
+			b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0x3, true, 0);
 	} else {
 		b43_phy_maskset(dev, B43_NPHY_AFECTL_C1, 0x0FFF, regs[0]);
 		b43_phy_maskset(dev, B43_NPHY_AFECTL_C2, 0x0FFF, regs[1]);
@@ -5161,6 +5209,10 @@ static void b43_nphy_tx_cal_phy_setup(struct b43_wldev *dev)
 
 	regs[0] = b43_phy_read(dev, B43_NPHY_AFECTL_C1);
 	regs[1] = b43_phy_read(dev, B43_NPHY_AFECTL_C2);
+	/* 0x2ff before the T/R switch override changes it, for the cleanup */
+	if (phy->rev >= 7 && phy->rev < 19)
+		regs[13] = b43_phy_read(dev, 0x2ff);
+
 	if (dev->phy.rev >= 3) {
 		b43_phy_maskset(dev, B43_NPHY_AFECTL_C1, 0xF0FF, 0x0A00);
 		b43_phy_maskset(dev, B43_NPHY_AFECTL_C2, 0xF0FF, 0x0A00);
@@ -5570,9 +5622,11 @@ static int b43_nphy_cal_tx_iq_lo(struct b43_wldev *dev,
 			}
 
 			b43_phy_write(dev, B43_NPHY_IQLOCAL_CMD, cmd);
+			/* wait for the command to finish: 0xC000 is busy, as in
+			 * brcmsmac (this broke out as soon as it was set) */
 			for (i = 0; i < 2000; i++) {
 				tmp = b43_phy_read(dev, B43_NPHY_IQLOCAL_CMD);
-				if (tmp & 0xC000)
+				if (!(tmp & 0xC000))
 					break;
 				udelay(10);
 			}
@@ -5592,8 +5646,10 @@ static int b43_nphy_cal_tx_iq_lo(struct b43_wldev *dev,
 		last = (dev->phy.rev < 3) ? 6 : 7;
 
 		if (!mphase || nphy->mphase_cal_phase_id == last) {
-			b43_ntab_write_bulk(dev, B43_NTAB16(15, 96), 4, buffer);
-			b43_ntab_read_bulk(dev, B43_NTAB16(15, 80), 4, buffer);
+			/* the best coefficients to the active ones, as wl and
+			 * brcmsmac: read at 96, write at 80 (this was reversed) */
+			b43_ntab_read_bulk(dev, B43_NTAB16(15, 96), 4, buffer);
+			b43_ntab_write_bulk(dev, B43_NTAB16(15, 80), 4, buffer);
 			if (dev->phy.rev < 3) {
 				buffer[0] = 0;
 				buffer[1] = 0;
@@ -5632,6 +5688,8 @@ static int b43_nphy_cal_tx_iq_lo(struct b43_wldev *dev,
 
 	b43_nphy_tx_cal_phy_cleanup(dev);
 	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, save);
+	if (dev->phy.rev >= 7 && dev->phy.rev < 19)
+		b43_nphy_tx_cal_radio_cleanup_rev7(dev);
 
 	if (dev->phy.rev < 2 && (!mphase || nphy->mphase_cal_phase_id == last))
 		b43_nphy_tx_iq_workaround(dev);
diff --git a/drivers/net/wireless/broadcom/b43/phy_n.h b/drivers/net/wireless/broadcom/b43/phy_n.h
index b96ded0..e9084d9 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.h
+++ b/drivers/net/wireless/broadcom/b43/phy_n.h
@@ -974,7 +974,7 @@ struct b43_phy_n {
 	int tx_pwr_last_recalc_limit;
 
 	u8 txrx_chain;
-	u16 tx_rx_cal_phy_saveregs[11];
+	u16 tx_rx_cal_phy_saveregs[14];
 	u16 tx_rx_cal_radio_saveregs[22];
 
 	u16 rfctrl_intc1_save;
-- 
2.53.0

