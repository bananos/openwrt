From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Druchenko <bananos@dev.co.ua>
Date: Fri, 27 Nov 2026 22:14:40 +0200
Subject: [PATCH] b43: N-PHY: fix the RX I/Q compensation computation

b43_nphy_calc_rx_iq_comp() did the arithmetic of brcmsmac's
wlc_phy_calc_rx_iq_comp_nphy() in u16: a, b and the divisors overflowed
(qq << (31 - nbits), a * a), and it negated the whole sum where only the
I/Q product term is negated. Use 32-bit values as brcmsmac does, and
retry a failed estimate up to three times as it does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/phy_n.c | 124 ++++++++++------------
 1 file changed, 57 insertions(+), 67 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/phy_n.c b/drivers/net/wireless/broadcom/b43/phy_n.c
index b38cee1..1ad4dbe 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -4633,93 +4633,83 @@ static void b43_nphy_rx_cal_phy_setup(struct b43_wldev *dev, u8 core)
 /* http://bcm-v4.sipsolutions.net/802.11/PHY/N/CalcRxIqComp */
 static void b43_nphy_calc_rx_iq_comp(struct b43_wldev *dev, u8 mask)
 {
-	int i;
-	s32 iq;
-	u32 ii;
-	u32 qq;
-	int iq_nbits, qq_nbits;
-	int arsh, brsh;
-	u16 tmp, a, b;
-
+	/*
+	 * As brcmsmac's wlc_phy_calc_rx_iq_comp_nphy(): 32-bit arithmetic (a,
+	 * b and the divisors were u16 and overflowed), a = -(iq << s) + ii >> t
+	 * (the whole sum was negated), and up to three retries.
+	 */
 	struct nphy_iq_est est;
 	struct b43_phy_n_iq_comp old;
 	struct b43_phy_n_iq_comp new = { };
-	bool error = false;
+	int i, retry;
+	bool error;
 
 	if (mask == 0)
 		return;
 
 	b43_nphy_rx_iq_coeffs(dev, false, &old);
 	b43_nphy_rx_iq_coeffs(dev, true, &new);
-	b43_nphy_rx_iq_est(dev, &est, 0x4000, 32, false);
-	new = old;
 
-	for (i = 0; i < 2; i++) {
-		if (i == 0 && (mask & 1)) {
-			iq = est.iq0_prod;
-			ii = est.i0_pwr;
-			qq = est.q0_pwr;
-		} else if (i == 1 && (mask & 2)) {
-			iq = est.iq1_prod;
-			ii = est.i1_pwr;
-			qq = est.q1_pwr;
-		} else {
-			continue;
-		}
+	for (retry = 0; retry <= 3; retry++) {
+		b43_nphy_rx_iq_est(dev, &est, 0x4000, 32, false);
+		new = old;
+		error = false;
 
-		if (ii + qq < 2) {
-			error = true;
-			break;
-		}
+		for (i = 0; i < 2; i++) {
+			s32 iq, a, b, temp;
+			u32 ii, qq;
+			int iq_nbits, qq_nbits, arsh, brsh;
 
-		iq_nbits = fls(abs(iq));
-		qq_nbits = fls(qq);
+			if (!(mask & (1 << i)))
+				continue;
+			iq = i ? est.iq1_prod : est.iq0_prod;
+			ii = i ? est.i1_pwr : est.i0_pwr;
+			qq = i ? est.q1_pwr : est.q0_pwr;
 
-		arsh = iq_nbits - 20;
-		if (arsh >= 0) {
-			a = -((iq << (30 - iq_nbits)) + (ii >> (1 + arsh)));
-			tmp = ii >> arsh;
-		} else {
-			a = -((iq << (30 - iq_nbits)) + (ii << (-1 - arsh)));
-			tmp = ii << -arsh;
-		}
-		if (tmp == 0) {
-			error = true;
-			break;
-		}
-		a /= tmp;
+			if (ii + qq < 2) {
+				error = true;
+				break;
+			}
 
-		brsh = qq_nbits - 11;
-		if (brsh >= 0) {
-			b = (qq << (31 - qq_nbits));
-			tmp = ii >> brsh;
-		} else {
-			b = (qq << (31 - qq_nbits));
-			tmp = ii << -brsh;
-		}
-		if (tmp == 0) {
-			error = true;
-			break;
-		}
-		b = int_sqrt(b / tmp - a * a) - (1 << 10);
+			iq_nbits = fls(abs(iq));
+			qq_nbits = fls(qq);
 
-		if (i == 0 && (mask & 0x1)) {
-			if (dev->phy.rev >= 3) {
-				new.a0 = a & 0x3FF;
-				new.b0 = b & 0x3FF;
+			arsh = iq_nbits - 20;
+			if (arsh >= 0) {
+				a = -(iq << (30 - iq_nbits)) + (s32)(ii >> (1 + arsh));
+				temp = (s32)(ii >> arsh);
 			} else {
-				new.a0 = b & 0x3FF;
-				new.b0 = a & 0x3FF;
+				a = -(iq << (30 - iq_nbits)) + (s32)(ii << (-1 - arsh));
+				temp = (s32)(ii << -arsh);
 			}
-		} else if (i == 1 && (mask & 0x2)) {
-			if (dev->phy.rev >= 3) {
-				new.a1 = a & 0x3FF;
-				new.b1 = b & 0x3FF;
+			if (temp == 0) {
+				error = true;
+				break;
+			}
+			a /= temp;
+
+			brsh = qq_nbits - 11;
+			b = (s32)(qq << (31 - qq_nbits));
+			temp = brsh >= 0 ? (s32)(ii >> brsh) : (s32)(ii << -brsh);
+			if (temp == 0) {
+				error = true;
+				break;
+			}
+			b /= temp;
+			b -= a * a;
+			b = (s32)int_sqrt((unsigned long)b);
+			b -= 1 << 10;
+
+			if (i == 0) {
+				new.a0 = (dev->phy.rev >= 3 ? a : b) & 0x3FF;
+				new.b0 = (dev->phy.rev >= 3 ? b : a) & 0x3FF;
 			} else {
-				new.a1 = b & 0x3FF;
-				new.b1 = a & 0x3FF;
+				new.a1 = (dev->phy.rev >= 3 ? a : b) & 0x3FF;
+				new.b1 = (dev->phy.rev >= 3 ? b : a) & 0x3FF;
 			}
 		}
+		if (!error)
+			break;
 	}
 
 	if (error)
-- 
2.53.0

