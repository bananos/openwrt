+/*
+ * 802.11n, HT20 (b43_setup_bands()): an MCS as the header carries it. The
+ * legacy rate with the same modulation and coding (MCS 7, 5/6, has none),
+ * and the data bits per OFDM symbol of one stream on 52 data subcarriers.
+ */
+static const u8 b43_mcs_legacy_rate[8] = {
+	B43_OFDM_RATE_6MB, B43_OFDM_RATE_12MB, B43_OFDM_RATE_18MB,
+	B43_OFDM_RATE_24MB, B43_OFDM_RATE_36MB, B43_OFDM_RATE_48MB,
+	B43_OFDM_RATE_54MB, B43_OFDM_RATE_54MB,
+};
+static const u16 b43_mcs_ndbps[8] = { 26, 52, 78, 104, 156, 208, 234, 260 };
+
+static bool b43_tx_rate_is_ht(struct b43_wldev *dev,
+			      const struct ieee80211_tx_rate *t)
+{
+	return dev->phy.nphy_ht && t->idx >= 0 && t->idx < 16 &&
+	       (t->flags & IEEE80211_TX_RC_MCS);
+}
+
+/* OFDM symbols of @octets of data (service and tail bits included) */
+static unsigned int b43_ht_symbols(u8 mcs, unsigned int octets)
+{
+	unsigned int ndbps = b43_mcs_ndbps[mcs % 8] * (mcs / 8 + 1);
+
+	return DIV_ROUND_UP(16 + 8 * octets + 6, ndbps);
+}
+
+/* Mixed-mode L-SIG length: 3 octets per 4 us after the L-SIG (HT-SIG,
+ * HT-STF, an HT-LTF per stream, the data), less 3. */
+static u16 b43_ht_lsig_len(u8 mcs, unsigned int octets)
+{
+	return 3 * (b43_ht_symbols(mcs, octets) + (mcs / 8 + 1) + 3) - 3;
+}
+
+/* Airtime of an HT20 mixed-mode PPDU at 2.4 GHz, signal extension included */
+static unsigned int b43_ht_airtime(u8 mcs, unsigned int octets)
+{
+	return 36 + 4 * (mcs / 8) + 4 * b43_ht_symbols(mcs, octets) + 6;
+}
+
+/*
+ * The NAV of an acknowledged HT frame: SIFS and the ACK at the mandatory
+ * OFDM rate (24, 12 or 6 Mbit/s) at or below the MCS's legacy rate.
+ * mac80211 leaves it to the driver for MCS rates.
+ */
+static u16 b43_ht_nav(u8 mcs)
+{
+	u8 rate = b43_mcs_legacy_rate[mcs % 8];
+	unsigned int ndbps = rate >= B43_OFDM_RATE_24MB ? 96 :
+			     rate >= B43_OFDM_RATE_12MB ? 48 : 24;
+
+	return 10 + 20 + 4 * DIV_ROUND_UP(16 + 8 * 14 + 6, ndbps) + 6;
+}
+
+/* The HT-SIG: MCS, 20 MHz, length; smoothing, not sounding, reserved bit
+ * set; no aggregation, STBC, LDPC or short GI. The PHY adds CRC and tail. */
+static void b43_generate_ht_sig(struct b43_plcp_hdr6 *plcp, u8 mcs,
+				unsigned int octets)
+{
+	memset(plcp, 0, sizeof(*plcp));
+	plcp->raw[0] = mcs;
+	plcp->raw[1] = octets & 0xff;
+	plcp->raw[2] = octets >> 8;
+	plcp->raw[3] = 0x07;
+}
+
+static u16 b43_generate_tx_phy_ctl1_ht(struct b43_wldev *dev, u8 mcs)
+{
+	const struct b43_tx_legacy_rate_phy_ctl_entry *e;
+	u16 control = B43_TXH_PHY1_BW_20;
+
+	if (mcs % 8 == 7) {
+		control |= B43_TXH_PHY1_CRATE_5_6 | B43_TXH_PHY1_MODUL_QAM64;
+	} else {
+		e = b43_tx_legacy_rate_phy_ctl_ent(b43_mcs_legacy_rate[mcs % 8]);
+		if (e)
+			control |= e->coding_rate | e->modulation;
+	}
+	/* Two streams on the two cores, or one sent on both (CDD) */
+	if (mcs >= 8)
+		return control | B43_TXH_PHY1_MODE_SDM |
+		       (1 << B43_TXH_PHY1_NSS_SHIFT);
+	return control | B43_TXH_PHY1_MODE_CDD;
+}
+
 /* Extract the bitrate index out of a CCK PLCP header. */
 static int b43_plcp_get_bitrate_idx_cck(struct b43_plcp_hdr6 *plcp)
 {
@@ -259,7 +344,7 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	    (const struct ieee80211_hdr *)fragment_data;
 	int use_encryption = !!info->control.hw_key;
