+++ b/drivers/net/wireless/broadcom/b43/xmit.h
@@ -173,6 +173,7 @@ struct b43_tx_legacy_rate_phy_ctl_entry {
 #define  B43_TXH_PHY1_MODE_CDD		0x0008 /* CDD */
 #define  B43_TXH_PHY1_MODE_STBC		0x0010 /* STBC */
