@@ -270,18 +355,52 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 			      phy->type == B43_PHYTYPE_HT);
 	u8 extra_ft = 0;
 	struct ieee80211_rate *txrate;
-	struct ieee80211_tx_rate *rates;
+	struct ieee80211_tx_rate *rates = info->control.rates;
+	struct ieee80211_supported_band *sband =
+		dev->wl->hw->wiphy->bands[info->band];
+	bool ht, ht_fb = false;
+	u8 mcs = 0, mcs_fb = 0;
 
 	memset(txhdr, 0, sizeof(*txhdr));
 
-	txrate = ieee80211_get_tx_rate(dev->wl->hw, info);
-	rate = txrate ? txrate->hw_value : B43_CCK_RATE_1MB;
+	/* 802.11n: an MCS, and an MCS or a legacy rate as the fallback */
+	ht = dev->fw.hdr_format == B43_FW_HDR_598 &&
+	     b43_tx_rate_is_ht(dev, &rates[0]);
+	if (ht) {
+		mcs = rates[0].idx;
+		txrate = NULL;
+		rate = b43_mcs_legacy_rate[mcs % 8];
+		if (b43_tx_rate_is_ht(dev, &rates[1])) {
+			ht_fb = true;
+			mcs_fb = rates[1].idx;
+		} else if (rates[1].idx >= 0 && !(rates[1].flags & IEEE80211_TX_RC_MCS) &&
+			   rates[1].idx < sband->n_bitrates) {
+			fbrate = &sband->bitrates[rates[1].idx];
+		} else {
+			ht_fb = true;
+			mcs_fb = mcs;
+		}
+		/* No RTS/CTS for HT frames yet: mac80211 computes their
+		 * durations from legacy rates only. */
+		rates[0].flags &= ~(IEEE80211_TX_RC_USE_RTS_CTS |
+				    IEEE80211_TX_RC_USE_CTS_PROTECT);
+	} else {
+		txrate = ieee80211_get_tx_rate(dev->wl->hw, info);
+		rate = txrate ? txrate->hw_value : B43_CCK_RATE_1MB;
+		/* A legacy rate falls back to itself rather than to an MCS */
+		if (rates[1].idx >= 0 && (rates[1].flags & IEEE80211_TX_RC_MCS))
+			fbrate = txrate;
+		else
+			fbrate = ieee80211_get_alt_retry_rate(dev->wl->hw, info, 0) ? : txrate;
+	}
 	rate_ofdm = b43_is_ofdm_rate(rate);
-	fbrate = ieee80211_get_alt_retry_rate(dev->wl->hw, info, 0) ? : txrate;
-	rate_fb = fbrate->hw_value;
+	rate_fb = ht_fb ? b43_mcs_legacy_rate[mcs_fb % 8] :
+		  (fbrate ? fbrate->hw_value : rate);
 	rate_fb_ofdm = b43_is_ofdm_rate(rate_fb);
 
-	if (rate_ofdm)
+	if (ht)
+		txhdr->phy_rate = mcs;
+	else if (rate_ofdm)
 		txhdr->phy_rate = b43_plcp_get_ratecode_ofdm(rate);
 	else
 		txhdr->phy_rate = b43_plcp_get_ratecode_cck(rate);
@@ -289,7 +408,9 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	memcpy(txhdr->tx_receiver, wlhdr->addr1, ETH_ALEN);
 
 	/* Calculate duration for fallback rate */
-	if ((rate_fb == rate) ||
+	if (ht) {
+		/* set below, after the frame's length is known */
+	} else if ((rate_fb == rate) ||
 	    (wlhdr->duration_id & cpu_to_le16(0x8000)) ||
 	    (wlhdr->duration_id == cpu_to_le16(0))) {
 		/* If the fallback rate equals the normal rate or the
@@ -350,7 +471,29 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 			memcpy(txhdr->iv, ((u8 *) wlhdr) + wlhdr_len, iv_len);
 		}
 	}
-	switch (dev->fw.hdr_format) {
+	if (ht) {
+		/* mac80211 leaves the NAV of an MCS frame to the driver */
+		u16 nav = 0, nav_fb = 0;
+
+		if (!(info->flags & IEEE80211_TX_CTL_NO_ACK) &&
+		    !is_multicast_ether_addr(wlhdr->addr1)) {
+			nav = b43_ht_nav(mcs);
+			nav_fb = ht_fb ? b43_ht_nav(mcs_fb) : nav;
+			if (ieee80211_has_morefrags(fctl)) {
+				/* the next fragment, at most as long as this */
+				nav = 3 * nav - 20 + b43_ht_airtime(mcs, plcp_fragment_len);
+				nav_fb = 3 * nav_fb - 20 +
+					 b43_ht_airtime(ht_fb ? mcs_fb : mcs,
+							plcp_fragment_len);
+			}
+		}
+		((struct ieee80211_hdr *)wlhdr)->duration_id = cpu_to_le16(nav);
+		txhdr->dur_fb = ht_fb || !fbrate ? cpu_to_le16(nav_fb) :
+			ieee80211_generic_frame_duration(dev->wl->hw,
+				info->control.vif, info->band, fragment_len, fbrate);
+		b43_generate_ht_sig(&txhdr->format_598.plcp, mcs, plcp_fragment_len);
+		txhdr->mimo_modelen = cpu_to_le16(b43_ht_lsig_len(mcs, plcp_fragment_len));
+	} else switch (dev->fw.hdr_format) {
 	case B43_FW_HDR_598:
 		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->format_598.plcp),
 				      plcp_fragment_len, rate);
@@ -364,11 +507,19 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 				      plcp_fragment_len, rate);
 		break;
 	}
-	b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->plcp_fb),
-			      plcp_fragment_len, rate_fb);
+	if (ht_fb) {
+		b43_generate_ht_sig(&txhdr->plcp_fb, mcs_fb, plcp_fragment_len);
+		txhdr->mimo_ratelen_fb =
+			cpu_to_le16(b43_ht_lsig_len(mcs_fb, plcp_fragment_len));
+	} else {
+		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->plcp_fb),
+				      plcp_fragment_len, rate_fb);
+	}
 
 	/* Extra Frame Types */
-	if (rate_fb_ofdm)
+	if (ht_fb)
+		extra_ft |= B43_TXH_EFT_FB_HT;
+	else if (rate_fb_ofdm)
 		extra_ft |= B43_TXH_EFT_FB_OFDM;
 	else
 		extra_ft |= B43_TXH_EFT_FB_CCK;
@@ -380,7 +531,9 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	txhdr->chan_radio_code = phy->channel;
 
 	/* PHY TX Control word */
-	if (rate_ofdm)
+	if (ht)
+		phy_ctl |= B43_TXH_PHY_ENC_HT;
+	else if (rate_ofdm)
 		phy_ctl |= B43_TXH_PHY_ENC_OFDM;
 	else
 		phy_ctl |= B43_TXH_PHY_ENC_CCK;
@@ -407,7 +560,6 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 		B43_WARN_ON(1);
 	}
 
-	rates = info->control.rates;
 	/* MAC control */
 	if (!(info->flags & IEEE80211_TX_CTL_NO_ACK))
 		mac_ctl |= B43_TXH_MAC_ACK;
@@ -566,10 +718,12 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	}
 
 	if (fill_phy_ctl1) {
-		txhdr->phy_ctl1 =
-			cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate));
-		txhdr->phy_ctl1_fb =
-			cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate_fb));
+		txhdr->phy_ctl1 = cpu_to_le16(ht ?
+			b43_generate_tx_phy_ctl1_ht(dev, mcs) :
+			b43_generate_tx_phy_ctl1(dev, rate));
+		txhdr->phy_ctl1_fb = cpu_to_le16(ht_fb ?
+			b43_generate_tx_phy_ctl1_ht(dev, mcs_fb) :
+			b43_generate_tx_phy_ctl1(dev, rate_fb));
 	}
 
 	/* Apply the bitfields */
@@ -766,7 +920,21 @@ void b43_rx(struct b43_wldev *dev, struct sk_buff *skb, const void *_rxhdr)
 		break;
 	}
 
-	if (phystat0 & B43_RX_PHYST0_OFDM)
+	if (dev->phy.nphy_ht &&
+	    (phystat0 & B43_RX_PHYST0_FTYPE) >= B43_RX_PHYST0_PRE_N) {
+		/* 802.11n: the PLCP is the HT-SIG. N-PHY rev 17 reports
+		 * standard HT frames as type 2 (PRE_N). */
+		rate_idx = plcp->raw[0] & 0x7f;
+		status.encoding = RX_ENC_HT;
+		if (plcp->raw[0] & 0x80)
+			status.bw = RATE_INFO_BW_40;
+		if (plcp->raw[3] & 0x80)
+			status.enc_flags |= RX_ENC_FLAG_SHORT_GI;
+		if (plcp->raw[3] & 0x40)
+			status.enc_flags |= RX_ENC_FLAG_LDPC;
+		if (rate_idx > 31)
+			rate_idx = -1;
+	} else if (phystat0 & B43_RX_PHYST0_OFDM)
 		rate_idx = b43_plcp_get_bitrate_idx_ofdm(plcp,
 					!!(chanstat & B43_RX_CHAN_5GHZ));
 	else
