diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 681b8bc..5691305 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -901,6 +901,8 @@ struct b43_wldev {
 struct b43_wl {
 	/* Pointer to the active wireless device on this chip */
 	struct b43_wldev *current_dev;
+	/* The 2 GHz band with HT capabilities, when the PHY runs HT */
+	struct ieee80211_supported_band band_2ghz_ht;
 	/* Pointer to the ieee80211 hardware data structure */
 	struct ieee80211_hw *hw;
 
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 8629b4b..8d0a669 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -113,6 +113,10 @@ MODULE_PARM_DESC(hwtkip, "Enable hardware tkip.");
 
 static int modparam_qos = 1;
 module_param_named(qos, modparam_qos, int, 0444);
+
+static int modparam_ht;
+module_param_named(ht, modparam_ht, int, 0444);
+MODULE_PARM_DESC(ht, "802.11n (HT20, no A-MPDU, experimental) on the N-PHYs it was tested on: 0=off (default), 1=MCS 0-15, 2=send one stream (MCS 0-7)");
 MODULE_PARM_DESC(qos, "Enable QOS support (default on)");
 
 static int modparam_btcoex = 1;
@@ -5357,6 +5361,35 @@ static int b43_setup_bands(struct b43_wldev *dev,
 			hw->wiphy->bands[NL80211_BAND_5GHZ] = &b43_band_5GHz_aphy;
 	}
 
+	/* 802.11n at 20 MHz (module parameter ht), so far on radio 2057 rev 13
+	 * (BCM5357/53572) only, where it was tested: MCS 0-15 sent and
+	 * received, no A-MPDU, no short guard interval. HT needs QoS (WMM).
+	 * Off by default: TX quality on this radio is not right yet (many
+	 * retries at every MCS), so it does not beat 802.11g so far.
+	 */
+	dev->phy.nphy_ht = false;
+	if (have_2ghz_phy && modparam_ht && modparam_qos &&
+	    phy->type == B43_PHYTYPE_N && phy->radio_ver == 0x2057 &&
+	    phy->radio_rev == 13) {
+		struct ieee80211_supported_band *band = &dev->wl->band_2ghz_ht;
+		struct ieee80211_sta_ht_cap *ht = &band->ht_cap;
+
+		*band = *hw->wiphy->bands[NL80211_BAND_2GHZ];
+		memset(ht, 0, sizeof(*ht));
+		ht->ht_supported = true;
+		ht->cap = WLAN_HT_CAP_SM_PS_DISABLED << IEEE80211_HT_CAP_SM_PS_SHIFT;
+		ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_8K;
+		ht->ampdu_density = IEEE80211_HT_MPDU_DENSITY_8;
+		ht->mcs.rx_mask[0] = 0xff;
+		ht->mcs.rx_mask[1] = 0xff;
+		ht->mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+		/* ht=2: send one stream only (MCS 0-7), receive two */
+		if (modparam_ht == 2)
+			ht->mcs.tx_params |= IEEE80211_HT_MCS_TX_RX_DIFF;
+		hw->wiphy->bands[NL80211_BAND_2GHZ] = band;
+		dev->phy.nphy_ht = true;
+	}
+
 	dev->phy.supports_2ghz = have_2ghz_phy;
 	dev->phy.supports_5ghz = have_5ghz_phy;
 
