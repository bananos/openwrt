From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Druchenko <bananos@dev.co.ua>
Date: Sat, 28 Nov 2026 13:33:53 +0200
Subject: [PATCH] b43: 802.11n short guard interval at 20 MHz

Advertise SGI_20 and send a short guard interval when rate control asks
for it: the short GI bit in HT-SIG2, and an L-SIG length counting the
data symbols at 3.6 us (rounded up to whole 4 us units, as 802.11n's
TXTIME does). The fallback keeps its own rate's flag. ht_sgi=0 turns it
off. Receive already decoded it and reported RX_ENC_FLAG_SHORT_GI.

On an ASUS RT-N12 D1 (channel 11, HT20, ht=1) the Xiaomi client sends
and receives short GI; throughput is unchanged (AP->client 12.2 Mbit/s,
client->AP 21.9; 11.7 / 23.1 with ht_sgi=0), the link not being limited
by its PHY rate there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/main.c | 13 ++++++---
 drivers/net/wireless/broadcom/b43/xmit.c | 35 +++++++++++++++---------
 2 files changed, 31 insertions(+), 17 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 592552a..bc5b7a9 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -116,9 +116,13 @@ module_param_named(qos, modparam_qos, int, 0444);
 
 static int modparam_ht;
 module_param_named(ht, modparam_ht, int, 0444);
-MODULE_PARM_DESC(ht, "802.11n (HT20, no A-MPDU, experimental) on the N-PHYs it was tested on: 0=off (default), 1=MCS 0-15, 2=send one stream (MCS 0-7)");
+MODULE_PARM_DESC(ht, "802.11n (HT20, A-MPDU, experimental) on the N-PHYs it was tested on: 0=off (default), 1=MCS 0-15, 2=send one stream (MCS 0-7)");
 MODULE_PARM_DESC(qos, "Enable QOS support (default on)");
 
+static int modparam_ht_sgi = 1;
+module_param_named(ht_sgi, modparam_ht_sgi, int, 0444);
+MODULE_PARM_DESC(ht_sgi, "802.11n short guard interval at 20 MHz (1, default) or not (0)");
+
 static int modparam_btcoex = 1;
 module_param_named(btcoex, modparam_btcoex, int, 0444);
 MODULE_PARM_DESC(btcoex, "Enable Bluetooth coexistence (default on)");
@@ -5530,9 +5534,8 @@ static int b43_setup_bands(struct b43_wldev *dev,
 
 	/* 802.11n at 20 MHz (module parameter ht), so far on radio 2057 rev 13
 	 * (BCM5357/53572) only, where it was tested: MCS 0-15 sent and
-	 * received, no A-MPDU, no short guard interval. HT needs QoS (WMM).
-	 * Off by default: TX quality on this radio is not right yet (many
-	 * retries at every MCS), so it does not beat 802.11g so far.
+	 * received, A-MPDUs, the short guard interval (ht_sgi). HT needs QoS
+	 * (WMM). Off by default while experimental.
 	 */
 	dev->phy.nphy_ht = false;
 	if (have_2ghz_phy && modparam_ht && modparam_qos &&
@@ -5545,6 +5548,8 @@ static int b43_setup_bands(struct b43_wldev *dev,
 		memset(ht, 0, sizeof(*ht));
 		ht->ht_supported = true;
 		ht->cap = WLAN_HT_CAP_SM_PS_DISABLED << IEEE80211_HT_CAP_SM_PS_SHIFT;
+		if (modparam_ht_sgi)
+			ht->cap |= IEEE80211_HT_CAP_SGI_20;
 		ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_64K;
 		ht->ampdu_density = IEEE80211_HT_MPDU_DENSITY_8;
 		ht->mcs.rx_mask[0] = 0xff;
diff --git a/drivers/net/wireless/broadcom/b43/xmit.c b/drivers/net/wireless/broadcom/b43/xmit.c
index 800d49f..22e3af0 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
@@ -92,10 +92,15 @@ static unsigned int b43_ht_symbols(u8 mcs, unsigned int octets)
 }
 
 /* Mixed-mode L-SIG length: 3 octets per 4 us after the L-SIG (HT-SIG,
- * HT-STF, an HT-LTF per stream, the data), less 3. */
-static u16 b43_ht_lsig_len(u8 mcs, unsigned int octets)
+ * HT-STF, an HT-LTF per stream, the data), less 3. With the short guard
+ * interval the data symbols take 3.6 us, rounded up to 4 us in all. */
+static u16 b43_ht_lsig_len(u8 mcs, unsigned int octets, bool sgi)
 {
-	return 3 * (b43_ht_symbols(mcs, octets) + (mcs / 8 + 1) + 3) - 3;
+	unsigned int nsym = b43_ht_symbols(mcs, octets);
+
+	if (sgi)
+		nsym = DIV_ROUND_UP(9 * nsym, 10);
+	return 3 * (nsym + (mcs / 8 + 1) + 3) - 3;
 }
 
 /* Airtime of an HT20 mixed-mode PPDU at 2.4 GHz, signal extension included */
@@ -121,16 +126,17 @@ static u16 b43_ht_nav(u8 mcs, bool block_ack)
 }
 
 /* The HT-SIG: MCS, 20 MHz, length; smoothing, not sounding, reserved bit
- * set; aggregation as asked; no STBC, LDPC or short GI. The PHY adds CRC
- * and tail. */
+ * set; aggregation and short GI as asked; no STBC or LDPC. The PHY adds
+ * CRC and tail. */
 static void b43_generate_ht_sig(struct b43_plcp_hdr6 *plcp, u8 mcs,
-				unsigned int octets, bool aggregation)
+				unsigned int octets, bool aggregation,
+				bool sgi)
 {
 	memset(plcp, 0, sizeof(*plcp));
 	plcp->raw[0] = mcs;
 	plcp->raw[1] = octets & 0xff;
 	plcp->raw[2] = octets >> 8;
-	plcp->raw[3] = 0x07 | (aggregation ? 0x08 : 0);
+	plcp->raw[3] = 0x07 | (aggregation ? 0x08 : 0) | (sgi ? 0x80 : 0);
 }
 
 /* On-air PSDU length of a TX frame: the hardware appends ICV and FCS. */
@@ -147,7 +153,7 @@ unsigned int b43_tx_psdu_len(struct sk_buff *skb)
 /* The mixed-mode L-SIG length field (12 bits) limits an HT PPDU. */
 bool b43_ampdu_tx_fits(u8 mcs, unsigned int ampdu_len)
 {
-	return b43_ht_lsig_len(mcs, ampdu_len) <= 4095;
+	return b43_ht_lsig_len(mcs, ampdu_len, false) <= 4095;
 }
 
 /* Bytes from one MPDU start to the next for the peer's density code:
@@ -389,7 +395,7 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	struct ieee80211_tx_rate *rates = info->control.rates;
 	struct ieee80211_supported_band *sband =
 		dev->wl->hw->wiphy->bands[info->band];
-	bool ht, ht_fb = false;
+	bool ht, ht_fb = false, sgi = false, sgi_fb = false;
 	u8 mcs = 0, mcs_fb = 0;
 	unsigned int ppdu_len;
 
@@ -400,11 +406,13 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	     b43_tx_rate_is_ht(dev, &rates[0]);
 	if (ht) {
 		mcs = rates[0].idx;
+		sgi = rates[0].flags & IEEE80211_TX_RC_SHORT_GI;
 		txrate = NULL;
 		rate = b43_mcs_legacy_rate[mcs % 8];
 		if (b43_tx_rate_is_ht(dev, &rates[1])) {
 			ht_fb = true;
 			mcs_fb = rates[1].idx;
+			sgi_fb = rates[1].flags & IEEE80211_TX_RC_SHORT_GI;
 		} else if (!ampdu && rates[1].idx >= 0 && !(rates[1].flags & IEEE80211_TX_RC_MCS) &&
 			   rates[1].idx < sband->n_bitrates) {
 			fbrate = &sband->bitrates[rates[1].idx];
@@ -529,8 +537,9 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 		/* The first member's PLCP describes the whole A-MPDU */
 		ppdu_len = ampdu && ampdu->first ? ampdu->len : plcp_fragment_len;
 		b43_generate_ht_sig(&txhdr->format_598.plcp, mcs, ppdu_len,
-				    ampdu && ampdu->first);
-		txhdr->mimo_modelen = cpu_to_le16(b43_ht_lsig_len(mcs, ppdu_len));
+				    ampdu && ampdu->first, sgi);
+		txhdr->mimo_modelen = cpu_to_le16(b43_ht_lsig_len(mcs, ppdu_len,
+								  sgi));
 	} else switch (dev->fw.hdr_format) {
 	case B43_FW_HDR_598:
 		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->format_598.plcp),
@@ -548,9 +557,9 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	if (ht_fb) {
 		ppdu_len = ampdu && ampdu->first ? ampdu->len : plcp_fragment_len;
 		b43_generate_ht_sig(&txhdr->plcp_fb, mcs_fb, plcp_fragment_len,
-				    false);
+				    false, sgi_fb);
 		txhdr->mimo_ratelen_fb =
-			cpu_to_le16(b43_ht_lsig_len(mcs_fb, ppdu_len));
+			cpu_to_le16(b43_ht_lsig_len(mcs_fb, ppdu_len, sgi_fb));
 	} else {
 		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->plcp_fb),
 				      plcp_fragment_len, rate_fb);
-- 
2.53.0

