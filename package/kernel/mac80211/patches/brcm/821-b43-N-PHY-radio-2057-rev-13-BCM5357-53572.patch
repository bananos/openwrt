 		    !(radio_rev == 9 || radio_rev == 13 || radio_rev == 14))
 			unsupported = 1;
 		if (radio_id == 0x2057 && radio_rev == 13)
-			b43warn(dev->wl, "Radio 2057 rev 13 (BCM5357/53572) has no "
-				"init or channel tables yet: experimental\n");
+			b43warn(dev->wl, "Radio 2057 rev 13 (BCM5357/53572): "
+				"experimental support\n");
 		break;
 	case B43_PHYTYPE_LP:
 		if (radio_id != 0x2062 && radio_id != 0x2063)
@@ -5339,7 +5339,8 @@ static int b43_setup_bands(struct b43_wldev *dev,
 
 	/* We don't support all 2 GHz channels on some devices */
 	limited_2g = phy->radio_ver == 0x2057 &&
-		     (phy->radio_rev == 9 || phy->radio_rev == 14);
+		     (phy->radio_rev == 9 || phy->radio_rev == 13 ||
+		      phy->radio_rev == 14);
 	limited_5g = phy->radio_ver == 0x2057 &&
 		     phy->radio_rev == 9;
 
