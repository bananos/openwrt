+/*
+ * The members of the A-MPDU whose single status this is, in order, their
+ * slots freed. Returns the ring's queue, or -1 when the status matches no
+ * A-MPDU at the ring's start.
+ */
+int b43_dma_ampdu_complete(struct b43_wldev *dev,
+			   const struct b43_txstatus *status,
+			   struct sk_buff_head *mpdus)
+{
+	const struct b43_dma_ops *ops;
+	struct b43_dmaring *ring;
+	struct b43_dmadesc_meta *meta;
+	int slot, firstused;
+	bool last = false;
+
+	ring = parse_cookie(dev, status->cookie, &slot);
+	if (unlikely(!ring))
+		return -1;
+	ops = ring->ops;
+	firstused = ring->current_slot - ring->used_slots + 1;
+	if (firstused < 0)
+		firstused = ring->nr_slots + firstused;
+	if (unlikely(slot != firstused || ring->used_slots < 2)) {
+		b43dbg(dev->wl, "A-MPDU TX status for slot %d, not %d, ring %d\n",
+		       slot, firstused, ring->index);
+		return -1;
+	}
+	ops->idx2desc(ring, next_slot(ring, slot), &meta);
+	if (unlikely(!meta->ampdu)) {
+		/* Not sent as an A-MPDU: complete it as one frame */
+		b43_dma_handle_txstatus(dev, status);
+		return -1;
+	}
+
+	while (!last && ring->used_slots >= 2) {
+		struct ieee80211_tx_info *info;
+		struct b43_private_tx_info *priv_info;
+		struct sk_buff *skb;
+
+		ops->idx2desc(ring, next_slot(ring, slot), &meta);
+		skb = meta->skb;
+		if (unlikely(!meta->ampdu || !skb ||
+			     b43_dma_ptr_is_poisoned(skb))) {
+			b43dbg(dev->wl, "A-MPDU TX status ends at slot %d, ring %d\n",
+			       slot, ring->index);
+			break;
+		}
+		last = meta->ampdu_last;
+		info = IEEE80211_SKB_CB(skb);
+		priv_info = b43_get_priv_tx_info(info);
+		unmap_descbuffer(ring, meta->dmaaddr, skb->len, 1);
+		kfree(priv_info->bouncebuffer);
+		priv_info->bouncebuffer = NULL;
+		meta->skb = B43_DMA_PTR_POISON;
+		ops->idx2desc(ring, slot, &meta);
+		unmap_descbuffer(ring, meta->dmaaddr, b43_txhdr_size(dev), 1);
+		ring->used_slots -= 2;
+		slot = next_slot(ring, next_slot(ring, slot));
+#ifdef CPTCFG_B43_DEBUG
+		if (b43_txstatus_mpdu_acked(status, skb))
+			ring->nr_succeed_tx_packets++;
+		else
+			ring->nr_failed_tx_packets++;
+		ring->nr_total_packet_tries++;
+#endif
+		__skb_queue_tail(mpdus, skb);
+	}
+	if (ring->ampdu_pending)
+		ring->ampdu_pending--;
+	if (ring->stopped && free_slots(ring) >= TX_SLOTS_PER_FRAME)
+		ring->stopped = false;
+	return ring->queue_prio;
+}
