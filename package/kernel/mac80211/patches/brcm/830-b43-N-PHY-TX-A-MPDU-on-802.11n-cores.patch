+/*
+ * Post the @n members of one A-MPDU, all or none: the hardware starts on it
+ * after the last one. Returns @n, or the index of the member that could not
+ * be posted (none of them is then), with its error in *err.
+ */
+int b43_dma_tx_ampdu(struct b43_wldev *dev, u8 queue_prio,
+		     struct sk_buff **skbs,
+		     const struct b43_txhdr_ampdu *ampdu, unsigned int n)
+{
+	struct b43_dmaring *ring = select_ring_by_priority(dev, queue_prio);
+	int old_used_slots = ring->used_slots;
+	unsigned int i;
+	int err;
+
+	if (free_slots(ring) < (n + 1) * TX_SLOTS_PER_FRAME)
+		return -ENOSPC;
+	ring->queue_prio = queue_prio;
+	for (i = 0; i < n; i++) {
+		err = dma_tx_fragment(ring, skbs[i], &ampdu[i]);
+		if (unlikely(err)) {
+			dma_tx_unwind(ring, old_used_slots);
+			if (err != -ENOKEY)
+				b43err(dev->wl, "DMA tx mapping failure\n");
+			return err;
+		}
+	}
+	ring->ampdu_pending++;
+	if (free_slots(ring) < TX_SLOTS_PER_FRAME) {
+		ieee80211_stop_queue(dev->wl->hw, queue_prio);
+		dev->wl->tx_queue_stopped[queue_prio] = 1;
+		ring->stopped = true;
+	}
+	return 0;
+}
