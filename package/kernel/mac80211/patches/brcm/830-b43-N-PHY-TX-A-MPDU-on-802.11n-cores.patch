+/* Take back the slots after @old_used_slots that were not handed over */
+static void dma_tx_unwind(struct b43_dmaring *ring, int old_used_slots)
+{
+	const struct b43_dma_ops *ops = ring->ops;
+	struct b43_dmadesc_meta *meta;
+
+	while (ring->used_slots > old_used_slots) {
+		ops->idx2desc(ring, ring->current_slot, &meta);
+		if (meta->skb) {
+			struct b43_private_tx_info *priv_info =
+			     b43_get_priv_tx_info(IEEE80211_SKB_CB(meta->skb));
+
+			unmap_descbuffer(ring, meta->dmaaddr, meta->skb->len, 1);
+			kfree(priv_info->bouncebuffer);
+			priv_info->bouncebuffer = NULL;
+		} else {
+			unmap_descbuffer(ring, meta->dmaaddr,
+					 b43_txhdr_size(ring->dev), 1);
+		}
+		memset(meta, 0, sizeof(*meta));
+		ring->current_slot = prev_slot(ring, ring->current_slot);
+		ring->used_slots--;
+	}
+}
