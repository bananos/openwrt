+ * the initvals of microcode 666 give BE 14 blocks, less than an A-MPDU of a
+ * few frames, which then underflows (PHY TX errors). The microcode keeps
+ * the sizes in shared memory in pairs, FIFO 2n low and 2n+1 high, as these
+ * initvals write them. Before the DMA rings and with the MAC disabled.
+ */
+static const u8 b43_txfifo_blocks_nphy[6] = { 9, 58, 22, 14, 14, 5 };
+
+static void b43_txfifo_init_nphy(struct b43_wldev *dev)
+{
+	u16 def[6][2], old_def[6][2], sizes[3], old_sizes[3];
+	u16 sel = b43_read16(dev, B43_MMIO_XMTFIFOCMD);
+	u16 start = 6, end;
+	int i;
