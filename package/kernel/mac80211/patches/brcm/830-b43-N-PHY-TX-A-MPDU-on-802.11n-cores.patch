+	if (dev->dev->core_rev != 28 ||
+	    (b43_read32(dev, B43_MMIO_MACCTL) & B43_MACCTL_ENABLED))
+		return;
+	for (i = 0; i < 6; i++) {
+		end = start + b43_txfifo_blocks_nphy[i] - 1;
+		def[i][0] = (end & 0xff) << 8 | (start & 0xff);
+		def[i][1] = ((end >> 8) & 1) << 8 | ((start >> 8) & 1);
+		start = end + 1;
