+/* As b43_dma_handle_txstatus() ends: let the queue run again */
+void b43_dma_tx_wake(struct b43_wldev *dev, u8 queue_prio)
+{
+	if (dev->wl->tx_queue_stopped[queue_prio])
+		dev->wl->tx_queue_stopped[queue_prio] = 0;
+	else
+		ieee80211_wake_queue(dev->wl->hw, queue_prio);
+	ieee80211_queue_work(dev->wl->hw, &dev->wl->tx_work);
+}
