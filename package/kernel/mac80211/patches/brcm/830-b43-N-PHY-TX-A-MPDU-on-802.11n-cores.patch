index 0000000..399c4bc
--- /dev/null
+++ b/drivers/net/wireless/broadcom/b43/ampdu.c
@@ -0,0 +1,450 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Block ack sessions and the TX A-MPDUs b43 builds on 802.11n N-PHY cores.
+ *
+ * The microcode sends an A-MPDU whose members are posted to the DMA ring
+ * together (first, intermediate, last in their TX headers) and reports one
+ * TX status for it, followed by the block ack bitmap when one came. b43
+ * builds the A-MPDUs from its own TX queues: consecutive frames of one
+ * station and TID, inside the session's window. The members not
+ * acknowledged are sent again, a few times, ahead of the queue.
+ *
+ * The design follows b43-next's ampdu.c, without the TX queue scheduling
+ * mac80211 of 4.19 does not have.
+ */
+#include <linux/module.h>
+#include "b43.h"
+#include "ampdu.h"
+#include "dma.h"
+#include "main.h"
+#include "xmit.h"
+
+/* Driver retransmissions of a member not acknowledged; after
+ * B43_AMPDU_TX_RR_LIMIT of them its A-MPDU goes at the fallback rate. */
+static int modparam_ampdu_tx = 1;
+module_param_named(ampdu_tx, modparam_ampdu_tx, int, 0444);
+MODULE_PARM_DESC(ampdu_tx, "Send A-MPDUs on 802.11n (1, default) or not (0)");
+
+/* A data frame this long or longer carries bulk payload */
+#define B43_AMPDU_BULK_LEN		500
+/* Frames counted before the estimate is halved */
+#define B43_AMPDU_CLASSIFY_SPAN		256
+
+#define B43_AMPDU_TX_RETRY_LIMIT	6
+#define B43_AMPDU_TX_RR_LIMIT		2
+
+static u16 b43_ampdu_seq(const struct sk_buff *skb)
+{
+	const struct ieee80211_hdr *hdr = (const void *)skb->data;
+
+	return IEEE80211_SEQ_TO_SN(le16_to_cpu(hdr->seq_ctrl));
+}
+
+/* Whether a frame may be an A-MPDU member */
+static bool b43_ampdu_member(struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+
+	return (info->flags & IEEE80211_TX_CTL_AMPDU) &&
+	       !(info->flags & (IEEE80211_TX_CTL_NO_ACK |
+				IEEE80211_TX_CTL_SEND_AFTER_DTIM)) &&
+	       ieee80211_is_data_qos(hdr->frame_control) &&
+	       !ieee80211_has_morefrags(hdr->frame_control) &&
+	       ieee80211_get_tid(hdr) < B43_AMPDU_TIDS;
+}
+
+static bool b43_ampdu_same_flow(struct sk_buff *a, struct sk_buff *b)
+{
+	struct ieee80211_hdr *ha = (struct ieee80211_hdr *)a->data;
+	struct ieee80211_hdr *hb = (struct ieee80211_hdr *)b->data;
+
+	return ether_addr_equal(ha->addr1, hb->addr1) &&
+	       ieee80211_get_tid(ha) == ieee80211_get_tid(hb);
+}
+
+/* The TX state of a frame's station and TID, or NULL. Under rcu_read_lock. */
+static struct b43_ampdu_tx_tid *b43_ampdu_tid(struct b43_wl *wl,
+					      struct sk_buff *skb,
+					      struct ieee80211_sta **sta_out)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	struct ieee80211_sta *sta;
+
+	sta = ieee80211_find_sta_by_ifaddr(wl->hw, hdr->addr1, hdr->addr2);
+	if (sta_out)
+		*sta_out = sta;
+	if (!sta)
+		return NULL;
+	return &((struct b43_sta *)sta->drv_priv)->tid[ieee80211_get_tid(hdr) %
+						      B43_AMPDU_TIDS];
+}
+
+/* Null delimiters after an MPDU so that the next one starts at least
+ * spacing bytes after this one's start; at most 63. */
+static u8 b43_ampdu_ndelim(unsigned int mpdu, unsigned int spacing)
+{
+	unsigned int start = 4 + ALIGN(mpdu, 4);
+
+	return spacing > start ? min(DIV_ROUND_UP(spacing - start, 4), 63U) : 0;
+}
+
+/* Whether the flow is mostly short frames: aggregating TCP ACKs gains
+ * nothing and the station's reorder buffer delays them behind any hole,
+ * which costs more than half of an upload's rate. */
+static bool b43_ampdu_flow_brief(const struct b43_ampdu_tx_tid *t)
+{
+	return t->brief + t->bulk >= B43_AMPDU_CLASSIFY_SPAN / 4 &&
+	       t->bulk * 8 < t->brief;
+}
+
+/*
+ * Count a frame queued for @sta into its TID's estimate, and end the TX
+ * block ack session of a flow that went short. From b43_op_tx().
+ */
+void b43_ampdu_classify(struct ieee80211_sta *sta, struct sk_buff *skb)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	struct b43_ampdu_tx_tid *t;
+	u8 tid;
+
+	if (!sta || !ieee80211_is_data_qos(hdr->frame_control))
+		return;
+	tid = ieee80211_get_tid(hdr);
+	if (tid >= B43_AMPDU_TIDS)
+		return;
+	t = &((struct b43_sta *)sta->drv_priv)->tid[tid];
+	if (skb->len >= B43_AMPDU_BULK_LEN)
+		t->bulk++;
+	else
+		t->brief++;
+	if (t->bulk + t->brief >= B43_AMPDU_CLASSIFY_SPAN) {
+		t->bulk /= 2;
+		t->brief /= 2;
+	}
+	if (READ_ONCE(t->buf_size) && !t->stopping &&
+	    b43_ampdu_flow_brief(t)) {
+		t->stopping = true;
+		ieee80211_stop_tx_ba_session(sta, tid);
+	}
+}
+
+/*
+ * Send the frames at the head of @q as one A-MPDU. Returns 1 if they went
+ * out (or were dropped), 0 if the first frame is not for an A-MPDU (the
+ * caller sends it alone), -ENOSPC if the ring takes no A-MPDU now (the
+ * frames stay queued). Called from b43_tx_work() under wl->mutex.
+ */
+int b43_ampdu_tx(struct b43_wldev *dev, struct sk_buff_head *q,
+		 u8 queue_prio)
+{
+	struct b43_wl *wl = dev->wl;
+	struct sk_buff *skbs[B43_AMPDU_TX_MAX_MPDUS];
+	struct b43_txhdr_ampdu ampdu[B43_AMPDU_TX_MAX_MPDUS];
+	struct ieee80211_tx_info *first;
+	struct ieee80211_tx_rate *rates;
+	struct ieee80211_sta *sta;
+	struct b43_ampdu_tx_tid *t;
+	struct sk_buff *skb, *pos;
+	unsigned int n = 0, len = 0, pad = 0, max_n, max_len, spacing, i;
+	unsigned long flags;
+	u16 start;
+	u8 mcs;
+	int err;
+
+	skb = skb_peek(q);
+	if (!skb || !dev->phy.nphy_ht || b43_using_pio_transfers(dev) ||
+	    !b43_ampdu_member(skb))
+		return 0;
+	first = IEEE80211_SKB_CB(skb);
+	rates = first->control.rates;
+
+	rcu_read_lock();
+	t = b43_ampdu_tid(wl, skb, &sta);
+	if (!t || !t->buf_size) {
+		rcu_read_unlock();
+		return 0;
+	}
+	/* After a few failed tries the member's A-MPDU uses the fallback */
+	if (t->retries[b43_ampdu_seq(skb) % B43_AMPDU_TX_WINDOW] >
+	    B43_AMPDU_TX_RR_LIMIT && rates[1].idx >= 0 &&
+	    (rates[1].flags & IEEE80211_TX_RC_MCS))
+		rates[0] = rates[1];
+	if (!(rates[0].flags & IEEE80211_TX_RC_MCS) || rates[0].idx < 0 ||
+	    rates[0].idx > 15) {
+		rcu_read_unlock();
+		return 0;
+	}
+	mcs = rates[0].idx;
+	max_n = min_t(unsigned int, b43_dma_tx_ampdu_room(dev, queue_prio),
+		      B43_AMPDU_TX_MAX_MPDUS);
+	if (!max_n) {
+		rcu_read_unlock();
+		return -ENOSPC;
+	}
+	/* A rate control probe goes alone, as an ordinary MPDU */
+	if (first->flags & IEEE80211_TX_CTL_RATE_CTRL_PROBE) {
+		rcu_read_unlock();
+		return 0;
+	}
+	max_len = (1 << (IEEE80211_HT_MAX_AMPDU_FACTOR +
+			 sta->ht_cap.ampdu_factor)) - 1;
+	spacing = b43_ampdu_tx_spacing(mcs, sta->ht_cap.ampdu_density);
+	start = b43_ampdu_seq(skb);
+
+	spin_lock_irqsave(&q->lock, flags);
+	skb_queue_walk(q, pos) {
+		struct ieee80211_tx_info *info = IEEE80211_SKB_CB(pos);
+		unsigned int mpdu, next_len;
+
+		if (n == max_n)
+			break;
+		if (n && (!b43_ampdu_member(pos) ||
+			  (info->flags & IEEE80211_TX_CTL_RATE_CTRL_PROBE) ||
+			  !b43_ampdu_same_flow(skb, pos)))
+			break;
+		/* Inside the peer's window from the first member */
+		if (ieee80211_sn_sub(b43_ampdu_seq(pos), start) >= t->buf_size)
+			break;
+		/* Each MPDU follows a 4-byte delimiter and pads to 4 bytes */
+		mpdu = b43_tx_psdu_len(pos);
+		next_len = n ? len + pad + 4 + mpdu : 4 + mpdu;
+		if (n && (next_len > max_len || !b43_ampdu_tx_fits(mcs, next_len)))
+			break;
+		ampdu[n].ndelim = b43_ampdu_ndelim(mpdu, spacing);
+		pad = ALIGN(mpdu, 4) - mpdu + 4 * ampdu[n].ndelim;
+		len = next_len;
+		skbs[n++] = pos;
+	}
+	/*
+	 * A frame alone goes as an ordinary MPDU: the peer may answer an
+	 * A-MPDU of one MPDU with an ACK, which the microcode does not take
+	 * for its block ack (a third of them failed on a TCP ACK stream). It
+	 * waits while the ring is busy (b43_dma_tx_busy()), so that the frames
+	 * after it gather into an A-MPDU.
+	 */
+	if (n < 2) {
+		spin_unlock_irqrestore(&q->lock, flags);
+		rcu_read_unlock();
+		if (b43_dma_tx_busy(dev, queue_prio))
+			return -ENOSPC;
+		t->retries[start % B43_AMPDU_TX_WINDOW] = 0;
+		return 0;
+	}
+	for (i = 0; i < n; i++)
+		__skb_unlink(skbs[i], q);
+	spin_unlock_irqrestore(&q->lock, flags);
+	rcu_read_unlock();
+
+	/* Every member goes at the first member's rates */
+	for (i = 0; i < n; i++) {
+		struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skbs[i]);
+
+		if (i)
+			memcpy(info->control.rates, first->control.rates,
+			       sizeof(info->control.rates));
+		/* b43's bounce buffer pointer overwrote it on a retry */
+		info->control.vif = wl->vif;
+		ampdu[i].first = !i;
+		ampdu[i].last = i == n - 1;
+		ampdu[i].len = len;
+	}
+	ampdu[n - 1].ndelim = 0;
+
+	err = b43_dma_tx_ampdu(dev, queue_prio, skbs, ampdu, n);
+	if (err == -ENOSPC) {
+		for (i = n; i-- > 0;)
+			skb_queue_head(q, skbs[i]);
+		return -ENOSPC;
+	}
+	if (unlikely(err)) {
+		/* No key any more, or no DMA mapping: drop them */
+		for (i = 0; i < n; i++)
+			ieee80211_free_txskb(wl->hw, skbs[i]);
+	}
+	return 1;
+}
+
+/* Put a retransmission back at the head of @q, behind the earlier
+ * retransmissions of its flow, so that the next A-MPDU is in order. */
+static void b43_ampdu_requeue(struct sk_buff_head *q, struct sk_buff *skb)
+{
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *pos;
+	unsigned long flags;
+	u16 seq = b43_ampdu_seq(skb);
+
+	spin_lock_irqsave(&q->lock, flags);
+	skb_queue_walk(q, pos) {
+		hdr = (struct ieee80211_hdr *)pos->data;
+		if (!ieee80211_has_retry(hdr->frame_control) ||
+		    !b43_ampdu_same_flow(skb, pos) ||
+		    !ieee80211_sn_less(b43_ampdu_seq(pos), seq))
+			break;
+	}
+	/* At the end of the walk pos is the list head: append */
+	__skb_queue_before(q, pos, skb);
+	spin_unlock_irqrestore(&q->lock, flags);
+}
+
+/*
+ * Complete one A-MPDU from its status: the members acknowledged in the
+ * block ack bitmap and those out of retries go to mac80211, the others back
+ * to the queue. One rate control sample for the A-MPDU rides on a completed
+ * member (minstrel_ht skips the other members). Under wl->mutex.
+ */
+void b43_ampdu_txstatus(struct b43_wldev *dev,
+			const struct b43_txstatus *status)
+{
+	struct b43_wl *wl = dev->wl;
+	struct ieee80211_sta *sta = NULL;
+	struct b43_ampdu_tx_tid *t = NULL;
+	struct sk_buff_head mpdus, done, retry;
+	struct sk_buff *skb, *bar = NULL;
+	struct ieee80211_tx_info *info;
+	struct ieee80211_tx_rate rate = { .idx = -1 };
+	unsigned int n = 0, acked = 0;
+	int prio;
+
+	__skb_queue_head_init(&mpdus);
+	prio = b43_dma_ampdu_complete(dev, status, &mpdus);
+	if (prio < 0)
+		return;
+
+	__skb_queue_head_init(&done);
+	__skb_queue_head_init(&retry);
+	rcu_read_lock();
+	while ((skb = __skb_dequeue(&mpdus))) {
+		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+		u8 *tries;
+
+		info = IEEE80211_SKB_CB(skb);
+		if (!n) {
+			t = b43_ampdu_tid(wl, skb, &sta);
+			rate = info->control.rates[0];
+		}
+		n++;
+		tries = t ? &t->retries[b43_ampdu_seq(skb) % B43_AMPDU_TX_WINDOW] :
+			    NULL;
+		if (b43_txstatus_mpdu_acked(status, skb)) {
+			acked++;
+			if (tries)
+				*tries = 0;
+			ieee80211_tx_info_clear_status(info);
+			info->flags |= IEEE80211_TX_STAT_ACK;
+			__skb_queue_tail(&done, skb);
+		} else if (t && t->buf_size && *tries < B43_AMPDU_TX_RETRY_LIMIT) {
+			/* A probe tries its rate once, then goes on as an
+			 * ordinary frame */
+			info->flags &= ~IEEE80211_TX_CTL_RATE_CTRL_PROBE;
+			(*tries)++;
+			hdr->frame_control |= cpu_to_le16(IEEE80211_FCTL_RETRY);
+			__skb_queue_tail(&retry, skb);
+		} else {
+			if (tries)
+				*tries = 0;
+			ieee80211_tx_info_clear_status(info);
+			__skb_queue_tail(&done, skb);
+			/* mac80211 sends a BAR past the last dropped member */
+			if (t && t->buf_size)
+				bar = skb;
+		}
+	}
+
+	if (t) {
+		skb = skb_peek(&done);
+		if (skb) {
+			info = IEEE80211_SKB_CB(skb);
+			info->flags |= IEEE80211_TX_STAT_AMPDU;
+			info->status.ampdu_len = min(n + t->rc_len, 255U);
+			info->status.ampdu_ack_len = min(acked + t->rc_acked, 255U);
+			info->status.rates[0].idx = rate.idx;
+			info->status.rates[0].flags = rate.flags;
+			info->status.rates[0].count = 1;
+			info->status.rates[1].idx = -1;
+			t->rc_len = 0;
+			t->rc_acked = 0;
+		} else {
+			t->rc_len = min(t->rc_len + n, 255U);
+			t->rc_acked = min(t->rc_acked + acked, 255U);
+		}
+	}
+	rcu_read_unlock();
+	if (bar)
+		IEEE80211_SKB_CB(bar)->flags |= IEEE80211_TX_STAT_AMPDU_NO_BACK;
+
+	while ((skb = __skb_dequeue(&retry)))
+		b43_ampdu_requeue(&wl->tx_queue[prio], skb);
+	while ((skb = __skb_dequeue(&done)))
+		ieee80211_tx_status(wl->hw, skb);
+	b43_dma_tx_wake(dev, prio);
+}
+
+/*
+ * mac80211's block ack sessions. RX: the microcode answers an A-MPDU with a
+ * block ack (b43_write_mac_bssid_templates() gives it our address) and
+ * mac80211 reorders. TX: b43_ampdu_tx() builds the A-MPDUs.
+ */
+int b43_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		     struct ieee80211_ampdu_params *params)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_sta *bsta = (struct b43_sta *)params->sta->drv_priv;
+	struct b43_ampdu_tx_tid *t = NULL;
+	struct b43_wldev *dev;
+	int err = -EOPNOTSUPP;
+
+	if (params->tid < B43_AMPDU_TIDS)
+		t = &bsta->tid[params->tid];
+
+	switch (params->action) {
+	case IEEE80211_AMPDU_RX_START:
+	case IEEE80211_AMPDU_TX_START:
+		mutex_lock(&wl->mutex);
+		dev = wl->current_dev;
+		if (dev && b43_status(dev) >= B43_STAT_STARTED &&
+		    dev->phy.nphy_ht &&
+		    (params->action == IEEE80211_AMPDU_RX_START ||
+		     (t && modparam_ampdu_tx && !b43_using_pio_transfers(dev))))
+			err = 0;
+		/* No session for a flow of TCP ACKs; mac80211 asks again
+		 * later, by when it may carry bulk data */
+		if (!err && params->action == IEEE80211_AMPDU_TX_START &&
+		    b43_ampdu_flow_brief(t))
+			err = -EBUSY;
+		if (!err && params->action == IEEE80211_AMPDU_TX_START) {
+			t->stopping = false;
+			t->buf_size = 0;
+			memset(t->retries, 0, sizeof(t->retries));
+		}
+		mutex_unlock(&wl->mutex);
+		if (!err && params->action == IEEE80211_AMPDU_TX_START)
+			ieee80211_start_tx_ba_cb_irqsafe(vif, params->sta->addr,
+							 params->tid);
+		return err;
+	case IEEE80211_AMPDU_TX_OPERATIONAL:
+		if (!t)
+			return -EOPNOTSUPP;
+		mutex_lock(&wl->mutex);
+		t->buf_size = min_t(u16, params->buf_size, B43_AMPDU_TX_WINDOW);
+		mutex_unlock(&wl->mutex);
+		return 0;
+	case IEEE80211_AMPDU_TX_STOP_CONT:
+	case IEEE80211_AMPDU_TX_STOP_FLUSH:
+	case IEEE80211_AMPDU_TX_STOP_FLUSH_CONT:
+		/* Queued members go out as ordinary frames */
+		if (t) {
+			mutex_lock(&wl->mutex);
+			t->buf_size = 0;
+			mutex_unlock(&wl->mutex);
+		}
+		if (params->action == IEEE80211_AMPDU_TX_STOP_CONT)
+			ieee80211_stop_tx_ba_cb_irqsafe(vif, params->sta->addr,
+							params->tid);
+		return 0;
+	case IEEE80211_AMPDU_RX_STOP:
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
diff --git a/drivers/net/wireless/broadcom/b43/ampdu.h b/drivers/net/wireless/broadcom/b43/ampdu.h
new file mode 100644
index 0000000..6d1e7f0
--- /dev/null
+++ b/drivers/net/wireless/broadcom/b43/ampdu.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef B43_AMPDU_H_
+#define B43_AMPDU_H_
+
+#include <linux/skbuff.h>
+#include <linux/types.h>
+#include <net/mac80211.h>
+
+struct b43_wldev;
