+/* Whether the ring of @queue_prio is busy enough for a lone frame to wait
+ * for more: an A-MPDU or two frames in flight */
+bool b43_dma_tx_busy(struct b43_wldev *dev, u8 queue_prio)
+{
+	struct b43_dmaring *ring = select_ring_by_priority(dev, queue_prio);
+
+	return ring->ampdu_pending ||
+	       ring->used_slots >= 2 * TX_SLOTS_PER_FRAME;
+}
